<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.StartPage"
             BackgroundColor="#EAF4FF">

    <VerticalStackLayout 
        Padding="30" 
        Spacing="25" 
        VerticalOptions="Start">

        <Image Source="logofridgeloop.png"
               HorizontalOptions="Center"
               HeightRequest="220"
               Margin="0,10,0,10"/>

        <Label 
            Text="Bienvenido a FridgeLoop"
            FontSize="32"
            FontFamily="OpenSansBold"
            HorizontalOptions="Center"
            TextColor="#003366" />

        <Label 
            Text="Tu asistente inteligente de cocina"
            FontSize="18"
            HorizontalOptions="Center"
            TextColor="#336699" />

        <Button 
            Text="Iniciar sesión"
            FontSize="18"
            TextColor="White"
            BackgroundColor="#007ACC"
            CornerRadius="10"
            Clicked="OnLoginClicked" />

        <Button 
            Text="Registrarse"
            FontSize="18"
            TextColor="White"
            BackgroundColor="#005A9E"
            CornerRadius="10"
            Clicked="OnRegisterClicked"/>

        <!-- CheckBox de términos -->
        <HorizontalStackLayout HorizontalOptions="Center">
            <CheckBox x:Name="chkTerminos" Color="#007ACC" />
            <Label Text="Acepto los Términos y Políticas."
                   FontSize="12"
                   VerticalOptions="Center"
                   TextColor="#666" />
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>
