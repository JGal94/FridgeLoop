<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Frontend_Proyecto_Fridgeloop.Pages"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.CompraDetallePage"
             x:Name="page"
             Title="Detalle de Compra"
             BackgroundColor="#F8FAFC">

    <!-- ====== Recursos de estilos/colores ====== -->
    <ContentPage.Resources>
        <!-- Converters -->
        <local:SubtotalConverter x:Key="SubtotalConverter"/>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Spacing="20" Padding="20">

            <!-- Header Principal con botón de regreso -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Frame Grid.Column="0" 
                       BackgroundColor="White" 
                       CornerRadius="20" 
                       Padding="0" 
                       HasShadow="True"
                       WidthRequest="44"
                       HeightRequest="44"
                       VerticalOptions="Center">
                    <Button Text="←"
                            BackgroundColor="Transparent"
                            TextColor="#6B7280"
                            FontSize="18"
                            FontAttributes="Bold"
                            WidthRequest="44"
                            HeightRequest="44" />
                </Frame>

                <Frame Grid.Column="1" 
                       BackgroundColor="White" 
                       HasShadow="True" 
                       CornerRadius="20" 
                       Padding="24"
                       Margin="12,0,0,0">
                    <StackLayout Orientation="Horizontal" Spacing="16">
                        <Frame BackgroundColor="#3B82F6" 
                               CornerRadius="25" 
                               Padding="12" 
                               HasShadow="False"
                               WidthRequest="50"
                               HeightRequest="50">
                            <Label Text="🧾" 
                                   FontSize="20" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" />
                        </Frame>
                        <StackLayout VerticalOptions="Center" Spacing="4">
                            <Label Text="Detalle de Compra" 
                                   FontSize="22" 
                                   FontAttributes="Bold" 
                                   TextColor="#1F2937" />
                            <Label Text="Información completa de la transacción" 
                                   FontSize="14" 
                                   TextColor="#6B7280" />
                        </StackLayout>
                    </StackLayout>
                </Frame>
            </Grid>

            <!-- Card de estado de compra -->
            <Frame BackgroundColor="#F0FDF4" 
                   HasShadow="True" 
                   CornerRadius="16" 
                   Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Frame Grid.Column="0" 
                           BackgroundColor="#10B981" 
                           CornerRadius="20" 
                           Padding="10" 
                           HasShadow="False"
                           WidthRequest="40"
                           HeightRequest="40">
                        <Label Text="✅" 
                               FontSize="16" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                    </Frame>

                    <StackLayout Grid.Column="1" 
                                 VerticalOptions="Center" 
                                 Spacing="2"
                                 Margin="12,0">
                        <Label Text="Compra Completada" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="#064E3B" />
                        <Label Text="Todos los productos fueron registrados exitosamente" 
                               FontSize="12" 
                               TextColor="#059669" />
                    </StackLayout>

                    <Frame Grid.Column="2" 
                           BackgroundColor="White" 
                           CornerRadius="12" 
                           Padding="8,4" 
                           HasShadow="False"
                           VerticalOptions="Center">
                        <Label Text="💚" 
                               FontSize="16" 
                               HorizontalOptions="Center" />
                    </Frame>
                </Grid>
            </Frame>

            <!-- Información de la Compra -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   CornerRadius="16" 
                   Padding="24">
                <StackLayout Spacing="20">

                    <!-- Título de la sección -->
                    <StackLayout Orientation="Horizontal" 
                                 Spacing="12">
                        <Label Text="📋" FontSize="16" />
                        <Label Text="Resumen de Compra" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#1F2937" />
                    </StackLayout>

                    <!-- Grid de información -->
                    <Grid RowSpacing="16" ColumnSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Fecha -->
                        <Frame Grid.Row="0" Grid.Column="0"
                               BackgroundColor="#E0F2FE" 
                               HasShadow="False" 
                               CornerRadius="12" 
                               Padding="16">
                            <StackLayout Spacing="8">
                                <StackLayout Orientation="Horizontal" Spacing="8">
                                    <Frame BackgroundColor="#0EA5E9" 
                                           CornerRadius="8" 
                                           Padding="6" 
                                           HasShadow="False">
                                        <Label Text="📅" 
                                               FontSize="12" 
                                               TextColor="White" />
                                    </Frame>
                                    <Label Text="Fecha" 
                                           FontSize="12" 
                                           FontAttributes="Bold" 
                                           TextColor="#0C4A6E"
                                           VerticalOptions="Center" />
                                </StackLayout>
                                <Label Text="{Binding compra.fechaCompra, StringFormat='{0:dd MMM yyyy}'}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#0369A1" />
                                <Label Text="{Binding compra.fechaCompra, StringFormat='{0:HH:mm}'}"
                                       FontSize="12"
                                       TextColor="#0369A1" />
                            </StackLayout>
                        </Frame>

                        <!-- Cantidad de productos -->
                        <Frame Grid.Row="0" Grid.Column="1"
                               BackgroundColor="#F3E8FF" 
                               HasShadow="False" 
                               CornerRadius="12" 
                               Padding="16">
                            <StackLayout Spacing="8">
                                <StackLayout Orientation="Horizontal" Spacing="8">
                                    <Frame BackgroundColor="#8B5CF6" 
                                           CornerRadius="8" 
                                           Padding="6" 
                                           HasShadow="False">
                                        <Label Text="🛒" 
                                               FontSize="12" 
                                               TextColor="White" />
                                    </Frame>
                                    <Label Text="Productos" 
                                           FontSize="12" 
                                           FontAttributes="Bold" 
                                           TextColor="#6B21A8"
                                           VerticalOptions="Center" />
                                </StackLayout>
                                <Label Text="{Binding compra.items.Count, StringFormat='{0}'}"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="#7C3AED" />
                                <Label Text="artículos"
                                       FontSize="12"
                                       TextColor="#9333EA" />
                            </StackLayout>
                        </Frame>

                        <!-- Total pagado -->
                        <Frame Grid.Row="1" Grid.ColumnSpan="2"
                               BackgroundColor="#F0FDF4" 
                               HasShadow="False" 
                               CornerRadius="12" 
                               Padding="20">
                            <StackLayout Spacing="8">
                                <StackLayout Orientation="Horizontal" 
                                           HorizontalOptions="Center"
                                           Spacing="8">
                                    <Frame BackgroundColor="#10B981" 
                                           CornerRadius="8" 
                                           Padding="8" 
                                           HasShadow="False">
                                        <Label Text="💰" 
                                               FontSize="14" 
                                               TextColor="White" />
                                    </Frame>
                                    <Label Text="Total Pagado" 
                                           FontSize="16" 
                                           FontAttributes="Bold" 
                                           TextColor="#064E3B"
                                           VerticalOptions="Center" />
                                </StackLayout>
                                <Label Text="{Binding compra.total, StringFormat='₡{0:N0}'}"
                                       FontSize="32"
                                       FontAttributes="Bold"
                                       TextColor="#059669"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </Frame>
                    </Grid>
                </StackLayout>
            </Frame>

            <!-- Lista de Productos -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   CornerRadius="16" 
                   Padding="0"
                   Margin="0,0,0,8">
                <StackLayout Spacing="0">
                    <StackLayout Orientation="Horizontal" 
                                 Spacing="12" 
                                 Padding="24,20,24,16">
                        <Label Text="🛍️" FontSize="18" />
                        <Label Text="Productos Comprados" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#1F2937" />
                    </StackLayout>

                    <!-- Separador -->
                    <BoxView HeightRequest="1" 
                             BackgroundColor="#F3F4F6" 
                             HorizontalOptions="FillAndExpand"
                             Margin="24,0" />

                    <CollectionView ItemsSource="{Binding compra.items}"
                                    Margin="12,16,12,16">

                        <!-- Mensaje cuando está vacía -->
                        <CollectionView.EmptyView>
                            <Grid Padding="40,60">
                                <StackLayout HorizontalOptions="Center" 
                                           VerticalOptions="Center" 
                                           Spacing="16">
                                    <Frame BackgroundColor="#F3F4F6" 
                                           CornerRadius="30" 
                                           Padding="20" 
                                           HasShadow="False"
                                           HorizontalOptions="Center">
                                        <Label Text="📦" 
                                               FontSize="32" 
                                               HorizontalOptions="Center" />
                                    </Frame>
                                    <Label Text="Sin productos registrados" 
                                           FontSize="18" 
                                           FontAttributes="Bold" 
                                           TextColor="#374151"
                                           HorizontalOptions="Center" />
                                    <Label Text="No se encontraron productos en esta compra" 
                                           FontSize="14" 
                                           TextColor="#6B7280"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center" />
                                </StackLayout>
                            </Grid>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="#FAFBFC" 
                                       HasShadow="False" 
                                       CornerRadius="12" 
                                       Padding="20"
                                       Margin="4,4">
                                    <Grid ColumnDefinitions="*,Auto" 
                                          RowDefinitions="Auto,Auto" 
                                          ColumnSpacing="16"
                                          RowSpacing="12">

                                        <!-- Nombre del producto con ID -->
                                        <StackLayout Grid.Row="0" Grid.Column="0" 
                                                   Orientation="Horizontal" 
                                                   Spacing="12">
                                            <Frame BackgroundColor="#6366F1" 
                                                   CornerRadius="8" 
                                                   Padding="8,4" 
                                                   HasShadow="False"
                                                   VerticalOptions="Center">
                                                <Label Text="{Binding idProducto, StringFormat='#{0}'}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="White" />
                                            </Frame>
                                            <Label Text="{Binding nombre}" 
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#1F2937"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="FillAndExpand" />
                                        </StackLayout>

                                        <!-- Badge de cantidad -->
                                        <Frame Grid.Row="0" Grid.Column="1"
                                               BackgroundColor="#FEF3C7" 
                                               CornerRadius="16" 
                                               Padding="12,6" 
                                               HasShadow="False"
                                               VerticalOptions="Center">
                                            <Label Text="{Binding cantidad, StringFormat='×{0:0.##}'}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#92400E" />
                                        </Frame>

                                        <!-- Información de precio y unidad -->
                                        <StackLayout Grid.Row="1" Grid.Column="0" 
                                                   Orientation="Horizontal" 
                                                   Spacing="12">
                                            <Frame BackgroundColor="#DBEAFE" 
                                                   CornerRadius="8" 
                                                   Padding="8,4" 
                                                   HasShadow="False">
                                                <Label Text="{Binding unidad}" 
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="#1E40AF" />
                                            </Frame>
                                            <Label Text="{Binding precioUnitario, StringFormat='₡{0:N0} por unidad'}" 
                                                   FontSize="13" 
                                                   TextColor="#6B7280"
                                                   VerticalOptions="Center" />
                                        </StackLayout>

                                        <!-- Subtotal destacado -->
                                        <StackLayout Grid.Row="1" Grid.Column="1" 
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="End">
                                            <Frame BackgroundColor="#F0FDF4" 
                                                   CornerRadius="8" 
                                                   Padding="12,6" 
                                                   HasShadow="False">
                                                <Label Text="{Binding ., Converter={StaticResource SubtotalConverter}}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="#059669"
                                                       HorizontalTextAlignment="Center" />
                                            </Frame>
                                        </StackLayout>

                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>

            <!-- Opciones adicionales -->
            <StackLayout Spacing="12" Margin="0,8,0,40">
                <!-- Compartir compra -->
                <Frame BackgroundColor="White" 
                       CornerRadius="16" 
                       Padding="0" 
                       HasShadow="False"
                       BorderColor="#E5E7EB">
                    <Button Text="📤 Compartir Detalle de Compra" 
                            BackgroundColor="Transparent"
                            TextColor="#6366F1"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="50" />
                </Frame>

                <!-- Exportar -->
                <Frame BackgroundColor="#6366F1" 
                       CornerRadius="16" 
                       Padding="0" 
                       HasShadow="True">
                    <Button Text="💾 Exportar como PDF" 
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="50" />
                </Frame>
            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>