<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.LoginPage"
             BackgroundColor="#EAF4FF"
             Title="Iniciar Sesión">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Start">

            <Image Source="logofridgeloop.png"
                   HorizontalOptions="Center"
                   HeightRequest="220"
                   Margin="0,10,0,10"/>

            <Label Text="Bienvenido de nuevo"
                   FontSize="28"
                   FontFamily="OpenSansBold"
                   HorizontalOptions="Center"
                   TextColor="#003366" />

            <Frame CornerRadius="8" Padding="0" HasShadow="False" BackgroundColor="White">
                <Entry Placeholder="Correo electrónico"
                       FontSize="16"
                       Keyboard="Email"
                       BackgroundColor="Transparent"
                       TextColor="Black" />
            </Frame>

            <Frame CornerRadius="8" Padding="0" HasShadow="False" BackgroundColor="White">
                <Entry Placeholder="Contraseña"
                       FontSize="16"
                       IsPassword="True"
                       BackgroundColor="Transparent"
                       TextColor="Black" />
            </Frame>


            <Button Text="Iniciar sesión"
                    FontSize="18"
                    TextColor="White"
                    BackgroundColor="#007ACC"
                    CornerRadius="10"
                    Clicked="OnLoginClicked" />

            <!-- CheckBox: recordarme -->
            <HorizontalStackLayout HorizontalOptions="Center">
                <CheckBox x:Name="chkRecordarme" Color="#007ACC" />
                <Label Text="Recordarme en este dispositivo"
                               FontSize="12"
                               VerticalOptions="Center"
                               TextColor="#666" />  
            </HorizontalStackLayout>

            <Label Text="¿Olvidaste tu contraseña?"
                   FontSize="12"
                   HorizontalOptions="Center"
                   TextColor="#666" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
