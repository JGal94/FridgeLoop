<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.LoginPage"
             BackgroundColor="#F8FAFC"
             Title="Iniciar Sesión">

    <ScrollView>
        <StackLayout Spacing="24" Padding="24" VerticalOptions="Center">

            <!-- Logo y Header -->
            <StackLayout Spacing="20" Margin="0,40,0,20">
                <Frame BackgroundColor="White" 
                       HasShadow="True" 
                       CornerRadius="30" 
                       Padding="20"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">
                    <Image Source="logofridgeloop.png"
                           HorizontalOptions="Center"
                           HeightRequest="120"
                           WidthRequest="120" />
                </Frame>

                <StackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="¡Bienvenido de vuelta! 👋" 
                           FontSize="26" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"
                           TextColor="#1F2937" />
                    <Label Text="Inicia sesión para gestionar tu cocina inteligente" 
                           FontSize="16" 
                           HorizontalOptions="Center"
                           TextColor="#6B7280"
                           HorizontalTextAlignment="Center" />
                </StackLayout>
            </StackLayout>

            <!-- Formulario de Login -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   CornerRadius="20" 
                   Padding="24">
                <StackLayout Spacing="20">

                    <!-- Campo de Email -->
                    <StackLayout Spacing="8">
                        <Label Text="Correo Electrónico" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               TextColor="#374151" />
                        <Frame BackgroundColor="#F8FAFC" 
                               HasShadow="False" 
                               CornerRadius="12" 
                               Padding="0"
                               HeightRequest="50">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Frame Grid.Column="0" 
                                       BackgroundColor="#3B82F6" 
                                       CornerRadius="8" 
                                       Padding="8" 
                                       HasShadow="False"
                                       VerticalOptions="Center"
                                       Margin="12,0,0,0">
                                    <Label Text="📧" 
                                           FontSize="14" 
                                           TextColor="White"
                                           HorizontalOptions="Center" />
                                </Frame>
                                <Entry x:Name="txtCorreoLogin"
                                       Grid.Column="1"
                                       Placeholder="tu@email.com"
                                       FontSize="16"
                                       Keyboard="Email"
                                       BackgroundColor="Transparent"
                                       TextColor="#1F2937"
                                       PlaceholderColor="#9CA3AF"
                                       Margin="0,0,16,0" />
                            </Grid>
                        </Frame>
                    </StackLayout>

                    <!-- Campo de Contraseña -->
                    <StackLayout Spacing="8">
                        <Label Text="Contraseña" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               TextColor="#374151" />
                        <Frame BackgroundColor="#F8FAFC" 
                               HasShadow="False" 
                               CornerRadius="12" 
                               Padding="0"
                               HeightRequest="50">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Frame Grid.Column="0" 
                                       BackgroundColor="#8B5CF6" 
                                       CornerRadius="8" 
                                       Padding="8" 
                                       HasShadow="False"
                                       VerticalOptions="Center"
                                       Margin="12,0,0,0">
                                    <Label Text="🔒" 
                                           FontSize="14" 
                                           TextColor="White"
                                           HorizontalOptions="Center" />
                                </Frame>
                                <Entry x:Name="txtPasswordLogin"
                                       Grid.Column="1"
                                       Placeholder="Tu contraseña segura"
                                       FontSize="16"
                                       IsPassword="True"
                                       BackgroundColor="Transparent"
                                       TextColor="#1F2937"
                                       PlaceholderColor="#9CA3AF"
                                       Margin="0,0,16,0" />
                            </Grid>
                        </Frame>
                    </StackLayout>

                    <!-- Recordarme -->
                    <StackLayout Orientation="Horizontal" 
                               HorizontalOptions="Start"
                               Spacing="12"
                               Margin="0,8,0,0">
                        <CheckBox x:Name="chkRecordarme" 
                                  Color="#3B82F6" 
                                  VerticalOptions="Center" />
                        <Label Text="Recordarme en este dispositivo"
                               FontSize="14"
                               VerticalOptions="Center"
                               TextColor="#6B7280" />
                    </StackLayout>

                    <!-- Botón de Login -->
                    <Frame BackgroundColor="#6366F1" 
                           CornerRadius="25" 
                           Padding="0" 
                           HasShadow="True"
                           Margin="0,12,0,0">
                        <Button Text="🚀 Iniciar Sesión" 
                                BackgroundColor="Transparent"
                                TextColor="White"
                                FontSize="18"
                                FontAttributes="Bold"
                                HeightRequest="54"
                                Clicked="OnLoginClicked" />
                    </Frame>

                </StackLayout>
            </Frame>

            <!-- Opciones adicionales -->
            <StackLayout Spacing="16" Margin="0,8,0,40">

                <!-- ¿Olvidaste tu contraseña? -->
                <Frame BackgroundColor="#E0F2FE" 
                       HasShadow="False" 
                       CornerRadius="12" 
                       Padding="16">
                    <StackLayout Orientation="Horizontal" 
                               HorizontalOptions="Center"
                               Spacing="8">
                        <Label Text="🤔" FontSize="16" />
                        <Label Text="¿Olvidaste tu contraseña?"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#0369A1"
                               VerticalOptions="Center" />
                    </StackLayout>
                </Frame>

                <!-- Separador -->
                <StackLayout Orientation="Horizontal" 
                           HorizontalOptions="FillAndExpand"
                           Spacing="12"
                           Margin="20,16">
                    <BoxView HeightRequest="1" 
                             BackgroundColor="#E5E7EB" 
                             VerticalOptions="Center"
                             HorizontalOptions="FillAndExpand" />
                    <Label Text="o" 
                           FontSize="14" 
                           TextColor="#9CA3AF"
                           VerticalOptions="Center" />
                    <BoxView HeightRequest="1" 
                             BackgroundColor="#E5E7EB" 
                             VerticalOptions="Center"
                             HorizontalOptions="FillAndExpand" />
                </StackLayout>

                <!-- Crear cuenta -->
                <Frame BackgroundColor="White" 
                       HasShadow="False" 
                       CornerRadius="12" 
                       Padding="16"
                       BorderColor="#E5E7EB">
                    <StackLayout Orientation="Horizontal" 
                               HorizontalOptions="Center"
                               Spacing="8">
                        <Label Text="👤" FontSize="16" />
                        <Label Text="¿No tienes cuenta? "
                               FontSize="14"
                               TextColor="#6B7280"
                               VerticalOptions="Center" />
                        <Label Text="Crear una nueva"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#3B82F6"
                               VerticalOptions="Center" />
                    </StackLayout>
                </Frame>

            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>