<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.NotificacionesPage"
             Title="Notificaciones"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <StackLayout Spacing="20" Padding="20">

            <!-- Header con botón de regreso -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Frame Grid.Column="0" 
                       BackgroundColor="White" 
                       CornerRadius="20" 
                       Padding="0" 
                       HasShadow="True"
                       WidthRequest="44"
                       HeightRequest="44"
                       VerticalOptions="Center">
                    <Button Text="←"
                            BackgroundColor="Transparent"
                            TextColor="#6B7280"
                            FontSize="18"
                            FontAttributes="Bold" />
                </Frame>

                <Frame Grid.Column="1" 
                       BackgroundColor="White" 
                       HasShadow="True" 
                       CornerRadius="20" 
                       Padding="24"
                       Margin="12,0">
                    <StackLayout Orientation="Horizontal" Spacing="16">
                        <Frame BackgroundColor="#3B82F6" 
                               CornerRadius="25" 
                               Padding="12" 
                               HasShadow="False"
                               WidthRequest="50"
                               HeightRequest="50">
                            <Label Text="🔔" 
                                   FontSize="20" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" />
                        </Frame>
                        <StackLayout VerticalOptions="Center" Spacing="4">
                            <Label Text="Notificaciones" 
                                   FontSize="22" 
                                   FontAttributes="Bold" 
                                   TextColor="#1F2937" />
                            <Label Text="Alertas de vencimiento y recordatorios" 
                                   FontSize="14" 
                                   TextColor="#6B7280" />
                        </StackLayout>
                    </StackLayout>
                </Frame>

                <!-- Configuración -->
                <Frame Grid.Column="2" 
                       BackgroundColor="White" 
                       CornerRadius="20" 
                       Padding="0" 
                       HasShadow="True"
                       WidthRequest="44"
                       HeightRequest="44"
                       VerticalOptions="Center">
                    <Button Text="⚙️"
                            BackgroundColor="Transparent"
                            TextColor="#6B7280"
                            FontSize="16" />
                </Frame>
            </Grid>

            <!-- Resumen rápido -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   CornerRadius="16" 
                   Padding="20">
                <StackLayout Spacing="16">
                    <StackLayout Orientation="Horizontal" 
                                 Spacing="12">
                        <Label Text="📊" FontSize="16" />
                        <Label Text="Resumen de Alertas" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="#1F2937" />
                    </StackLayout>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Productos vencidos -->
                        <Frame Grid.Column="0" 
                               BackgroundColor="#FEE2E2" 
                               HasShadow="False" 
                               CornerRadius="12" 
                               Padding="12">
                            <StackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="⚠️" FontSize="18" HorizontalOptions="Center" />
                                <Label Text="3" 
                                       FontSize="16" 
                                       FontAttributes="Bold"
                                       TextColor="#B91C1C"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Vencidos" 
                                       FontSize="10" 
                                       TextColor="#DC2626"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </Frame>

                        <!-- Por vencer -->
                        <Frame Grid.Column="1" 
                               BackgroundColor="#FEF3C7" 
                               HasShadow="False" 
                               CornerRadius="12" 
                               Padding="12">
                            <StackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="⏰" FontSize="18" HorizontalOptions="Center" />
                                <Label Text="5" 
                                       FontSize="16" 
                                       FontAttributes="Bold"
                                       TextColor="#92400E"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Por vencer" 
                                       FontSize="10" 
                                       TextColor="#D97706"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </Frame>

                        <!-- Total activas -->
                        <Frame Grid.Column="2" 
                               BackgroundColor="#E0F2FE" 
                               HasShadow="False" 
                               CornerRadius="12" 
                               Padding="12">
                            <StackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="📋" FontSize="18" HorizontalOptions="Center" />
                                <Label Text="8" 
                                       FontSize="16" 
                                       FontAttributes="Bold"
                                       TextColor="#0369A1"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Total" 
                                       FontSize="10" 
                                       TextColor="#0284C7"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </Frame>
                    </Grid>
                </StackLayout>
            </Frame>

            <!-- Lista de Notificaciones -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   CornerRadius="16" 
                   Padding="0"
                   Margin="0,0,0,8">
                <StackLayout Spacing="0">
                    <StackLayout Orientation="Horizontal" 
                                 Spacing="12" 
                                 Padding="20,16,20,12">
                        <Label Text="🔔" FontSize="16" />
                        <Label Text="Notificaciones Activas" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="#1F2937" />
                    </StackLayout>

                    <!-- Separador -->
                    <BoxView HeightRequest="1" 
                             BackgroundColor="#F3F4F6" 
                             HorizontalOptions="FillAndExpand"
                             Margin="20,0" />

                    <CollectionView x:Name="cvNotificaciones"
                                    SelectionMode="Single"
                                    SelectionChanged="OnNotificacionSeleccionada"
                                    Margin="8,16,8,16">

                        <!-- Vista cuando no hay datos -->
                        <CollectionView.EmptyView>
                            <Grid Padding="40,60">
                                <StackLayout HorizontalOptions="Center" 
                                           VerticalOptions="Center" 
                                           Spacing="16">
                                    <Frame BackgroundColor="#F3F4F6" 
                                           CornerRadius="30" 
                                           Padding="20" 
                                           HasShadow="False"
                                           HorizontalOptions="Center">
                                        <Label Text="🔕" 
                                               FontSize="32" 
                                               HorizontalOptions="Center" />
                                    </Frame>
                                    <Label Text="Sin notificaciones" 
                                           FontSize="18" 
                                           FontAttributes="Bold" 
                                           TextColor="#374151"
                                           HorizontalOptions="Center" />
                                    <Label Text="No tienes alertas pendientes en este momento" 
                                           FontSize="14" 
                                           TextColor="#6B7280"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center" />
                                </StackLayout>
                            </Grid>
                        </CollectionView.EmptyView>

                        <!-- Item Template -->
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="#FAFBFC" 
                                       HasShadow="False" 
                                       CornerRadius="12" 
                                       Padding="0"
                                       Margin="4,4">

                                    <!-- Tap en la tarjeta -->
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnItemTapped" NumberOfTapsRequired="1"/>
                                    </Frame.GestureRecognizers>

                                    <Grid ColumnDefinitions="Auto,*,Auto" 
                                          RowDefinitions="Auto,Auto,Auto" 
                                          ColumnSpacing="16"
                                          Padding="20">

                                        <!-- Indicador de estado -->
                                        <Frame Grid.RowSpan="3" Grid.Column="0"
                                               BackgroundColor="#EF4444" 
                                               CornerRadius="20" 
                                               Padding="12" 
                                               HasShadow="False"
                                               WidthRequest="40"
                                               HeightRequest="40"
                                               VerticalOptions="Start">
                                            <Label Text="⚠️" 
                                                   FontSize="16" 
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                            <!-- Triggers para cambiar color según tipo -->
                                            <Frame.Triggers>
                                                <DataTrigger TargetType="Frame"
                                                             Binding="{Binding Tipo}"
                                                             Value="danger">
                                                    <Setter Property="BackgroundColor" Value="#F59E0B"/>
                                                </DataTrigger>
                                            </Frame.Triggers>
                                        </Frame>

                                        <!-- Título de la notificación -->
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Titulo}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#1F2937"
                                               LineBreakMode="TailTruncation" />

                                        <!-- Subtítulo/descripción -->
                                        <Label Grid.Row="1" Grid.Column="1"
                                               Text="{Binding Subtitulo}"
                                               FontSize="14"
                                               TextColor="#6B7280"
                                               LineBreakMode="WordWrap"
                                               Margin="0,4,0,8" />

                                        <!-- Categoría o tipo -->
                                        <StackLayout Grid.Row="2" Grid.Column="1" 
                                                   Orientation="Horizontal" 
                                                   Spacing="8">
                                            <Frame BackgroundColor="#FEE2E2" 
                                                   CornerRadius="6" 
                                                   Padding="6,3" 
                                                   HasShadow="False">
                                                <Label Text="🚨 Vencido" 
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="#B91C1C" />
                                                <!-- Trigger para cambiar según tipo -->
                                                <Frame.Triggers>
                                                    <DataTrigger TargetType="Frame"
                                                                 Binding="{Binding Tipo}"
                                                                 Value="danger">
                                                        <Setter Property="BackgroundColor" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                </Frame.Triggers>
                                            </Frame>
                                        </StackLayout>

                                        <!-- Fecha y hora -->
                                        <StackLayout Grid.RowSpan="3" Grid.Column="2" 
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="End"
                                                   Spacing="4">
                                            <Frame BackgroundColor="#F3F4F6" 
                                                   CornerRadius="8" 
                                                   Padding="8,4" 
                                                   HasShadow="False">
                                                <Label Text="{Binding FechaExpira, StringFormat='{}{0:dd/MM}'}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="#374151"
                                                       HorizontalTextAlignment="Center" />
                                            </Frame>
                                            <Label Text="📅" 
                                                   FontSize="12" 
                                                   HorizontalTextAlignment="Center"
                                                   TextColor="#9CA3AF" />
                                        </StackLayout>

                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>

            <!-- Acciones rápidas -->
            <StackLayout Spacing="12" Margin="0,8,0,40">

                <!-- Marcar todas como leídas -->
                <Frame BackgroundColor="White" 
                       CornerRadius="16" 
                       Padding="0" 
                       HasShadow="False"
                       BorderColor="#6B7280">
                    <Button Text="✅ Marcar Todas como Leídas" 
                            BackgroundColor="Transparent"
                            TextColor="#6B7280"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="50" />
                </Frame>

                <!-- Configurar alertas -->
                <Frame BackgroundColor="#6366F1" 
                       CornerRadius="16" 
                       Padding="0" 
                       HasShadow="True">
                    <Button Text="⚙️ Configurar Alertas" 
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="50" />
                </Frame>

            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>