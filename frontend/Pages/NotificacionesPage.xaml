<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.NotificacionesPage"
             Title="Notificaciones"
             BackgroundColor="#EAF4FF">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label Text="Notificaciones"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#003366" />

            <CollectionView x:Name="cvNotificaciones"
                            SelectionMode="None">

                <CollectionView.EmptyView>
                    <Grid Padding="24">
                        <Label Text="— Sin notificaciones —"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontSize="16"
                               TextColor="#667892"/>
                    </Grid>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- Tarjeta: por defecto AMARILLO; si Tipo == danger, se pinta ROJO -->
                        <Frame Padding="14"
                               CornerRadius="12"
                               HasShadow="True"
                               Margin="0,0,0,12"
                               BackgroundColor="#FFF3CD"
                               BorderColor="#E0B200">

                            <!-- Cambios de color si es 'danger' -->
                            <Frame.Triggers>
                                <DataTrigger TargetType="Frame"
                                             Binding="{Binding Tipo}"
                                             Value="danger">
                                    <Setter Property="BackgroundColor" Value="#F8D7DA"/>
                                    <Setter Property="BorderColor" Value="#C82333"/>
                                </DataTrigger>
                            </Frame.Triggers>

                            <!-- Estilos internos dependientes de 'Tipo' -->
                            <Frame.Resources>
                                <Style TargetType="BoxView">
                                    <Setter Property="Color" Value="#E0B200"/>
                                    <Style.Triggers>
                                        <DataTrigger TargetType="BoxView"
                                                     Binding="{Binding Tipo}"
                                                     Value="danger">
                                            <Setter Property="Color" Value="#C82333"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>

                                <Style TargetType="Label">
                                    <Setter Property="TextColor" Value="#856404"/>
                                    <Style.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Tipo}"
                                                     Value="danger">
                                            <Setter Property="TextColor" Value="#721C24"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Frame.Resources>

                            <Grid ColumnDefinitions="6,*,Auto"
                                  RowDefinitions="Auto,Auto">

                                <!-- Indicador lateral -->
                                <BoxView Grid.RowSpan="2"
                                         Grid.Column="0"
                                         WidthRequest="6"
                                         HeightRequest="40"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         CornerRadius="3"/>

                                <!-- Título -->
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Titulo}"
                                       FontSize="17"
                                       FontAttributes="Bold"/>

                                <!-- Subtítulo -->
                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding Subtitulo}"
                                       FontSize="14"/>

                                <!-- Fecha -->
                                <Label Grid.RowSpan="2" Grid.Column="2"
                                       Text="{Binding FechaExpira, StringFormat='{}{0:dd/MM/yyyy}'}"
                                       FontSize="12"
                                       TextColor="#607D8B"
                                       HorizontalTextAlignment="End"
                                       VerticalTextAlignment="Center" />

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
