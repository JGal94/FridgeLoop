<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.NotificacionesPage"
             Title="Notificaciones"
             BackgroundColor="#EAF4FF">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label Text="Notificaciones"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#003366"/>

            <CollectionView x:Name="cvNotificaciones"
                            SelectionMode="Single"
                            SelectionChanged="OnNotificacionSeleccionada">

                <!-- Vista cuando no hay datos -->
                <CollectionView.EmptyView>
                    <Grid Padding="24">
                        <Label Text="— Sin notificaciones —"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontSize="16"
                               TextColor="#667892"/>
                    </Grid>
                </CollectionView.EmptyView>

                <!-- Item -->
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="14"
                               CornerRadius="12"
                               HasShadow="True"
                               Margin="0,6"
                               BackgroundColor="#FFE8E8"
                               BorderColor="#D9534F">

                            <!-- Cambiar a amarillo cuando Tipo == danger -->
                            <Frame.Triggers>
                                <DataTrigger TargetType="Frame"
                                             Binding="{Binding Tipo}"
                                             Value="danger">
                                    <Setter Property="BackgroundColor" Value="#FFF3CD"/>
                                    <Setter Property="BorderColor"     Value="#E0B000"/>
                                </DataTrigger>
                            </Frame.Triggers>

                            <!-- Tap en la tarjeta -->
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemTapped" NumberOfTapsRequired="1"/>
                            </Frame.GestureRecognizers>

                            <!-- CONTENIDO ÚNICO del Frame -->
                            <Grid ColumnDefinitions="4,*,Auto"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="2">

                                <!-- Barra lateral -->
                                <BoxView Grid.RowSpan="2"
                                         WidthRequest="6"
                                         HorizontalOptions="Start"
                                         CornerRadius="3"
                                         Color="#D9534F">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView"
                                                     Binding="{Binding Tipo}"
                                                     Value="danger">
                                            <Setter Property="Color" Value="#E0B000"/>
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>

                                <!-- Título (con separación) -->
                                <Label Grid.Column="1" Grid.Row="0"
                                       Text="{Binding Titulo}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       Margin="6,0,0,0"
                                       TextColor="#0B325C"/>

                                <!-- Subtítulo -->
                                <Label Grid.Column="1" Grid.Row="1"
                                       Text="{Binding Subtitulo}"
                                       FontSize="14"
                                       Margin="6,0,0,0"
                                       TextColor="#3B4A5A"/>

                                <!-- Fecha (ojo con StringFormat: llaves escapadas con {}) -->
                                <Label Grid.Column="2" Grid.RowSpan="2"
                                       Text="{Binding FechaExpira, StringFormat='{}{0:dd/MM/yyyy}'}"
                                       FontSize="12"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="End"
                                       TextColor="#607D8B"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
