<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.HistorialComprasPage"
             Title="Historial de Compras"
             BackgroundColor="#EAF4FF">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Start">

            <Image Source="logofridgeloop.png"
                   HorizontalOptions="Center"
                   HeightRequest="200"
                   Margin="0,10,0,10" />

            <Label Text="Historial de compras anteriores"
                   FontSize="20"
                   FontFamily="OpenSansBold"
                   TextColor="#003366" />

            <!-- Compra 1 -->
            <Frame BackgroundColor="#FFFFFF" CornerRadius="12" Padding="15" HasShadow="True">
                <VerticalStackLayout>
                    <Label Text="🛒 Compra del 15/07/2025"
                           FontSize="16"
                           FontFamily="OpenSansSemiBold"
                           TextColor="#004C99" />

                    <Label Text="• Leche x2 - ₡1600\n• Pan x1 - ₡900\n• Atún x2 - ₡2400"
                           FontSize="14"
                           TextColor="#333" />

                    <Label Text="Total: ₡4900"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#003366" />
                </VerticalStackLayout>
            </Frame>

            <!-- Compra 2 -->
            <Frame BackgroundColor="#FFFFFF" CornerRadius="12" Padding="15" HasShadow="True">
                <VerticalStackLayout>
                    <Label Text="🛒 Compra del 01/07/2025"
                           FontSize="16"
                           FontFamily="OpenSansSemiBold"
                           TextColor="#004C99" />

                    <Label Text="• Tomate x5 - ₡1200\n• Queso x1 - ₡1800"
                           FontSize="14"
                           TextColor="#333" />

                    <Label Text="Total: ₡3000"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#003366" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
