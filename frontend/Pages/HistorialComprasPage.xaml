<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.HistorialComprasPage"
             Title="Historial de Compras"
             BackgroundColor="#EAF4FF">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label Text="Historial de compras anteriores"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#003366" />

            <CollectionView x:Name="cvCompras"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Grid Padding="16">
                        <Label Text="Aún no hay compras registradas."
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontSize="16"
                               TextColor="#667892"/>
                    </Grid>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#FFFFFF"
                               CornerRadius="12"
                               Padding="15"
                               HasShadow="True">

                            <!-- 👇 GestureRecognizer para abrir detalle -->
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Compra_Tapped"
                                                      CommandParameter="{Binding idCompra}" />
                            </Frame.GestureRecognizers>

                            <VerticalStackLayout Spacing="8">

                                <!-- Encabezado: fecha de compra -->
                                <Label FontSize="16"
                                       TextColor="#004C99"
                                       FontAttributes="Bold">
                                    <Label.Text>
                                        <Binding Path="fechaCompra"
                                                 StringFormat="🛒 Compra del {0:dd/MM/yyyy}"
                                                 TargetNullValue="🛒 Compra sin fecha"/>
                                    </Label.Text>
                                </Label>

                                <!-- Lista de items -->
                                <VerticalStackLayout Spacing="2"
                                                     BindableLayout.ItemsSource="{Binding items}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Label FontSize="14" TextColor="#333">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="• {0} x{1:0.##} - ₡{2:N0}">
                                                        <Binding Path="nombre"/>
                                                        <Binding Path="cantidad"/>
                                                        <Binding Path="precioUnitario" TargetNullValue="0"/>
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <!-- Total -->
                                <Label FontSize="14"
                                       TextColor="#003366"
                                       FontAttributes="Bold">
                                    <Label.Text>
                                        <Binding Path="total" StringFormat="Total: ₡{0:N0}"/>
                                    </Label.Text>
                                </Label>

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
