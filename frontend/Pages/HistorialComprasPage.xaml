<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.HistorialComprasPage"
             Title="Historial de Compras"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <StackLayout Spacing="16" Padding="20">

            <!-- Header Principal -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   CornerRadius="20" 
                   Padding="24"
                   Margin="0,0,0,8">
                <StackLayout Orientation="Horizontal" Spacing="16">
                    <Frame BackgroundColor="#8B5CF6" 
                           CornerRadius="25" 
                           Padding="12" 
                           HasShadow="False"
                           WidthRequest="50"
                           HeightRequest="50">
                        <Label Text="📊" 
                               FontSize="20" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                    </Frame>
                    <StackLayout VerticalOptions="Center" Spacing="4">
                        <Label Text="Historial de Compras" 
                               FontSize="22" 
                               FontAttributes="Bold" 
                               TextColor="#1F2937" />
                        <Label Text="Revisa tus compras anteriores" 
                               FontSize="14" 
                               TextColor="#6B7280" />
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- Sección de Compras -->
            <Frame BackgroundColor="#E0F2FE" 
                   HasShadow="True" 
                   CornerRadius="16" 
                   Padding="0"
                   Margin="0,0,0,8">
                <StackLayout Spacing="0">
                    <StackLayout Orientation="Horizontal" 
                                 Spacing="12" 
                                 Padding="20,16,20,12">
                        <Label Text="🛒" FontSize="16" />
                        <Label Text="Compras Realizadas" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="#1F2937" />
                    </StackLayout>

                    <CollectionView x:Name="cvCompras"
                                    SelectionMode="None"
                                    Margin="8,0,8,8">

                        <!-- Mensaje cuando está vacía -->
                        <CollectionView.EmptyView>
                            <Grid Padding="40,60">
                                <StackLayout HorizontalOptions="Center" 
                                           VerticalOptions="Center" 
                                           Spacing="12">
                                    <Frame BackgroundColor="#F3F4F6" 
                                           CornerRadius="30" 
                                           Padding="20" 
                                           HasShadow="False"
                                           HorizontalOptions="Center">
                                        <Label Text="📋" 
                                               FontSize="30" 
                                               HorizontalOptions="Center" />
                                    </Frame>
                                    <Label Text="Sin historial de compras" 
                                           FontSize="18" 
                                           FontAttributes="Bold" 
                                           TextColor="#374151"
                                           HorizontalOptions="Center" />
                                    <Label Text="Realiza tu primera compra para ver el historial aquí" 
                                           FontSize="14" 
                                           TextColor="#6B7280"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center" />
                                </StackLayout>
                            </Grid>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="White" 
                                       HasShadow="True" 
                                       CornerRadius="16" 
                                       Padding="20"
                                       Margin="0,4">

                                    <!-- Gesture para tap -->
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="Compra_Tapped"
                                                              CommandParameter="{Binding idCompra}" />
                                    </Frame.GestureRecognizers>

                                    <StackLayout Spacing="16">

                                        <!-- Header de la compra -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Icono de fecha -->
                                            <Frame Grid.Column="0" 
                                                   BackgroundColor="#3B82F6" 
                                                   CornerRadius="20" 
                                                   Padding="8" 
                                                   HasShadow="False"
                                                   WidthRequest="36"
                                                   HeightRequest="36">
                                                <Label Text="📅" 
                                                       FontSize="14" 
                                                       HorizontalOptions="Center" 
                                                       VerticalOptions="Center" />
                                            </Frame>

                                            <!-- Fecha de compra -->
                                            <StackLayout Grid.Column="1" 
                                                       VerticalOptions="Center" 
                                                       Spacing="2"
                                                       Margin="12,0">
                                                <Label Text="Compra realizada" 
                                                       FontSize="12" 
                                                       TextColor="#6B7280" />
                                                <Label FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="#1F2937"
                                                       Text="{Binding fechaCompra, StringFormat='{0:dd/MM/yyyy}', TargetNullValue='Sin fecha'}" />
                                            </StackLayout>

                                            <!-- Total destacado -->
                                            <StackLayout Grid.Column="2" 
                                                       VerticalOptions="Center" 
                                                       Spacing="2"
                                                       HorizontalOptions="End">
                                                <Label Text="Total" 
                                                       FontSize="12" 
                                                       TextColor="#6B7280"
                                                       HorizontalTextAlignment="End" />
                                                <Label FontSize="18"
                                                       FontAttributes="Bold"
                                                       TextColor="#059669"
                                                       HorizontalTextAlignment="End"
                                                       Text="{Binding total, StringFormat='₡{0:N0}'}" />
                                            </StackLayout>
                                        </Grid>

                                        <!-- Separador sutil -->
                                        <BoxView HeightRequest="1" 
                                                 BackgroundColor="#E5E7EB" 
                                                 HorizontalOptions="FillAndExpand" />

                                        <!-- Lista de productos -->
                                        <StackLayout Spacing="8"
                                                     BindableLayout.ItemsSource="{Binding items}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="Auto,*,Auto" 
                                                          ColumnSpacing="12"
                                                          Padding="0,4">

                                                        <!-- Bullet point -->
                                                        <Frame Grid.Column="0" 
                                                               BackgroundColor="#F3F4F6" 
                                                               CornerRadius="4" 
                                                               Padding="6,3" 
                                                               HasShadow="False"
                                                               VerticalOptions="Start">
                                                            <Label Text="•" 
                                                                   FontSize="12" 
                                                                   TextColor="#9CA3AF"
                                                                   HorizontalOptions="Center" />
                                                        </Frame>

                                                        <!-- Nombre y cantidad del producto -->
                                                        <StackLayout Grid.Column="1" 
                                                                   VerticalOptions="Center" 
                                                                   Spacing="2">
                                                            <Label Text="{Binding nombre}" 
                                                                   FontSize="14" 
                                                                   FontAttributes="Bold"
                                                                   TextColor="#374151"
                                                                   LineBreakMode="TailTruncation" />
                                                            <Label Text="{Binding cantidad, StringFormat='Cantidad: {0:0.##}'}" 
                                                                   FontSize="12" 
                                                                   TextColor="#6B7280" />
                                                        </StackLayout>

                                                        <!-- Precio del producto -->
                                                        <Label Grid.Column="2" 
                                                               Text="{Binding precioUnitario, StringFormat='₡{0:N0}', TargetNullValue='—'}"
                                                               FontSize="13"
                                                               FontAttributes="Bold"
                                                               TextColor="#059669"
                                                               VerticalOptions="Center"
                                                               HorizontalTextAlignment="End" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </StackLayout>

                                        <!-- Indicador de tap -->
                                        <StackLayout Orientation="Horizontal" 
                                                   HorizontalOptions="Center" 
                                                   Spacing="8"
                                                   Margin="0,8,0,0">
                                            <Label Text="👆" 
                                                   FontSize="12" 
                                                   TextColor="#9CA3AF" />
                                            <Label Text="Toca para ver más detalles" 
                                                   FontSize="12" 
                                                   TextColor="#9CA3AF"
                                                   FontAttributes ="Italic" />
                                        </StackLayout>

                                    </StackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>

        </StackLayout>
    </ScrollView>
</ContentPage>