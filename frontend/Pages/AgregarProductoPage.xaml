<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.AgregarProductoPage"
             Title="Agregar Producto"
             BackgroundColor="#EAF4FF">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">

            <Label Text="Agregar nuevo producto"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#003366" />

            <!-- Name -->
            <Frame BackgroundColor="#D6F0FF" CornerRadius="10" Padding="10,6">
                <Entry x:Name="txtNombre"
                       Placeholder="Nombre (Name)"
                       FontSize="16"
                       BackgroundColor="Transparent"
                       TextColor="#003366" />
            </Frame>

            <!-- Quantity (opcional) -->
            <Frame BackgroundColor="#D6F0FF" CornerRadius="10" Padding="10,6">
                <Entry x:Name="txtCantidad"
                       Placeholder="Cantidad (Quantity, opcional)"
                       Keyboard="Numeric"
                       FontSize="16"
                       BackgroundColor="Transparent"
                       TextColor="#003366" />
            </Frame>

            <!-- Unidad (Picker) -->
            <Frame BackgroundColor="#D6F0FF" CornerRadius="10" Padding="10,6">
                <Picker x:Name="pkUnidad"
            Title="Seleccionar unidad"
            TitleColor="#666"
            TextColor="#003366">
                    <!-- El orden debe coincidir con _unidadByIndex del code-behind -->
                    <Picker.Items>
                        <x:String>kg</x:String>
                        <x:String>g</x:String>
                        <x:String>ml</x:String>
                        <x:String>L</x:String>
                        <x:String>pz</x:String>
                        <x:String>unid</x:String>
                        <x:String>pack</x:String>
                    </Picker.Items>
                </Picker>
            </Frame>


            <!-- ExpirationDate (opcional) -->
            <Frame BackgroundColor="#D6F0FF" CornerRadius="10" Padding="10,6">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Text="Expira:" VerticalTextAlignment="Center" TextColor="#003366" />
                    <DatePicker x:Name="dpExpira" Grid.Column="1" TextColor="#003366" />
                </Grid>
            </Frame>

            <!-- CategoryID (Picker → se mapea a IDs en code-behind) -->
            <Frame BackgroundColor="#D6F0FF" CornerRadius="10" Padding="10,6">
                <Picker x:Name="pkCategoria"
                        Title="Seleccionar categoría"
                        TitleColor="#666"
                        TextColor="#003366">
                    <!-- Orden debe coincidir con el arreglo _categoryIdByIndex del code-behind -->
                    <Picker.Items>
                        <x:String>Enlatados</x:String>
                        <x:String>Lácteos</x:String>
                        <x:String>Verduras</x:String>
                        <x:String>Frutas</x:String>
                        <x:String>Otros</x:String>
                    </Picker.Items>
                </Picker>
            </Frame>

            <!-- Código de barras (rellenado por ScanPage) -->
            <Frame BackgroundColor="#D6F0FF" CornerRadius="10" Padding="10,6">
                <Entry x:Name="codigoEntry"
                       Placeholder="Código de barras (se completa al escanear)"
                       IsReadOnly="True"
                       FontSize="16"
                       BackgroundColor="Transparent"
                       TextColor="#003366" />
            </Frame>

            <Button Text="📷 Escanear código de barras"
                    BackgroundColor="#005A9E"
                    TextColor="White"
                    CornerRadius="10"
                    Clicked="OnEscanearClicked" />

            <Button Text="Guardar"
                    BackgroundColor="#007ACC"
                    TextColor="White"
                    CornerRadius="10"
                    Clicked="OnGuardarProductoClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
