<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.PerfilPage"
             Title="Perfil de Usuario"
             BackgroundColor="#EAF4FF">


    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label Text="Perfil de usuario"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#003366"/>

            <!-- Cambiar nombre -->
            <Frame BackgroundColor="#FFFFFF" CornerRadius="12" Padding="14" HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Cambiar nombre"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#003366"/>

                    <!-- IMPORTANTE: text visible -->
                    <Entry x:Name="txtNombre"
                           Placeholder="Nuevo nombre"
                           FontSize="16"
                           TextColor="#003366"
                           PlaceholderColor="#8AA0B8"
                           BackgroundColor="Transparent" />

                    <Button Text="Guardar nombre"
                            BackgroundColor="#007ACC"
                            TextColor="White"
                            CornerRadius="10"
                            Clicked="OnGuardarNombreClicked"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Cambiar contraseña -->
            <Frame BackgroundColor="#FFFFFF" CornerRadius="12" Padding="14" HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Cambiar contraseña"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#003366"/>

                    <!-- Se ven puntitos -->
                    <Entry x:Name="txtPwdActual"
                           Placeholder="Contraseña actual"
                           IsPassword="True"
                           FontSize="16"
                           TextColor="#003366"
                           PlaceholderColor="#8AA0B8"
                           BackgroundColor="Transparent"/>

                    <Entry x:Name="txtPwdNueva"
                           Placeholder="Nueva contraseña"
                           IsPassword="True"
                           FontSize="16"
                           TextColor="#003366"
                           PlaceholderColor="#8AA0B8"
                           BackgroundColor="Transparent"/>

                    <Entry x:Name="txtPwdConfirmar"
                           Placeholder="Confirmar nueva contraseña"
                           IsPassword="True"
                           FontSize="16"
                           TextColor="#003366"
                           PlaceholderColor="#8AA0B8"
                           BackgroundColor="Transparent"/>

                    <Button Text="Actualizar contraseña"
                            BackgroundColor="#28A745"
                            TextColor="White"
                            CornerRadius="10"
                            Clicked="OnCambiarPasswordClicked"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
