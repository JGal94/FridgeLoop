<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.DashboardPage"
             Title="Dashboard"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <StackLayout Spacing="20" Padding="20">

            <!-- Header Principal con Saludo -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   CornerRadius="20" 
                   Padding="24"
                   Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4">
                        <Label Text="¡Hola! 👋" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               TextColor="#1F2937" />
                        <Label Text="Gestiona tu cocina inteligentemente" 
                               FontSize="14" 
                               TextColor="#6B7280" />
                    </StackLayout>

                    <!-- Botones del header -->
                    <Frame Grid.Column="1" 
                           BackgroundColor="#3B82F6" 
                           CornerRadius="20" 
                           Padding="0" 
                           HasShadow="False"
                           Margin="4,0">
                        <Button Text="🔔" 
                                BackgroundColor="Transparent"
                                TextColor="White"
                                FontSize="16"
                                WidthRequest="44"
                                HeightRequest="44"
                                Clicked="OnNotificacionesClicked" />
                    </Frame>

                    <Frame Grid.Column="2" 
                           BackgroundColor="#8B5CF6" 
                           CornerRadius="20" 
                           Padding="0" 
                           HasShadow="False"
                           Margin="4,0">
                        <Button Text="👤" 
                                BackgroundColor="Transparent"
                                TextColor="White"
                                FontSize="16"
                                WidthRequest="44"
                                HeightRequest="44"
                                Clicked="OnPerfilClicked" />
                    </Frame>

                    <Frame Grid.Column="3" 
                           BackgroundColor="#6B7280" 
                           CornerRadius="20" 
                           Padding="0" 
                           HasShadow="False"
                           Margin="4,0">
                        <Button Text="⚙️" 
                                BackgroundColor="Transparent"
                                TextColor="White"
                                FontSize="16"
                                WidthRequest="44"
                                HeightRequest="44"
                                Clicked="OnConfiguracionClicked" />
                    </Frame>
                </Grid>
            </Frame>

            <!-- Card de Productos por Vencer -->
            <Frame x:Name="cardPV"
                   BackgroundColor="#FEF3C7" 
                   HasShadow="True" 
                   CornerRadius="16" 
                   Padding="20">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFrameTapped" />
                </Frame.GestureRecognizers>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Frame Grid.Column="0" 
                           BackgroundColor="#F59E0B" 
                           CornerRadius="25" 
                           Padding="12" 
                           HasShadow="False"
                           WidthRequest="50"
                           HeightRequest="50">
                        <Label Text="⚠️" 
                               FontSize="20" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                    </Frame>

                    <StackLayout Grid.Column="1" 
                                 VerticalOptions="Center" 
                                 Spacing="4"
                                 Margin="16,0">
                        <Label x:Name="lblPVTitle"
                               Text="Productos por vencer"
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="#92400E" />
                        <Label x:Name="lblPVSubtitle"
                               Text="Cargando..."
                               FontSize="14" 
                               TextColor="#B45309"
                               LineBreakMode="TailTruncation" />
                    </StackLayout>

                    <Frame Grid.Column="2" 
                           BackgroundColor="White" 
                           CornerRadius="20" 
                           Padding="0" 
                           HasShadow="False"
                           VerticalOptions="Center">
                        <Button Text="Ver todas" 
                                BackgroundColor="Transparent"
                                TextColor="#F59E0B"
                                FontSize="12"
                                FontAttributes="Bold"
                                WidthRequest="80"
                                HeightRequest="36"
                                Clicked="OnVerTodasNotiClicked" />
                    </Frame>
                </Grid>
            </Frame>

            <!-- Accesos Rápidos -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   CornerRadius="16" 
                   Padding="20">
                <StackLayout Spacing="16">
                    <StackLayout Orientation="Horizontal" 
                                 Spacing="12">
                        <Label Text="🚀" FontSize="16" />
                        <Label Text="Accesos Rápidos" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#1F2937" />
                    </StackLayout>

                    <!-- Grid de accesos rápidos -->
                    <Grid RowSpacing="12" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Inventario -->
                        <Frame Grid.Row="0" Grid.Column="0" 
                               BackgroundColor="#E0F2FE" 
                               HasShadow="False" 
                               CornerRadius="16" 
                               Padding="16"
                               HeightRequest="100">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="GoToInventario" />
                            </Frame.GestureRecognizers>
                            <StackLayout VerticalOptions="Center" 
                                       HorizontalOptions="Center" 
                                       Spacing="8">
                                <Frame BackgroundColor="#0EA5E9" 
                                       CornerRadius="20" 
                                       Padding="8" 
                                       HasShadow="False"
                                       HorizontalOptions="Center">
                                    <Label Text="📦" 
                                           FontSize="20" 
                                           TextColor="White" />
                                </Frame>
                                <Label Text="Inventario" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#0C4A6E"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </Frame>

                        <!-- Lista de Compras -->
                        <Frame Grid.Row="0" Grid.Column="1" 
                               BackgroundColor="#F0FDF4" 
                               HasShadow="False" 
                               CornerRadius="16" 
                               Padding="16"
                               HeightRequest="100">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="GoToCompras" />
                            </Frame.GestureRecognizers>
                            <StackLayout VerticalOptions="Center" 
                                       HorizontalOptions="Center" 
                                       Spacing="8">
                                <Frame BackgroundColor="#10B981" 
                                       CornerRadius="20" 
                                       Padding="8" 
                                       HasShadow="False"
                                       HorizontalOptions="Center">
                                    <Label Text="🛒" 
                                           FontSize="20" 
                                           TextColor="White" />
                                </Frame>
                                <Label Text="Compras" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#064E3B"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </Frame>

                        <!-- Recetas -->
                        <Frame Grid.Row="1" Grid.Column="0" 
                               BackgroundColor="#FEF3C7" 
                               HasShadow="False" 
                               CornerRadius="16" 
                               Padding="16"
                               HeightRequest="100">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="GoToRecetas" />
                            </Frame.GestureRecognizers>
                            <StackLayout VerticalOptions="Center" 
                                       HorizontalOptions="Center" 
                                       Spacing="8">
                                <Frame BackgroundColor="#F59E0B" 
                                       CornerRadius="20" 
                                       Padding="8" 
                                       HasShadow="False"
                                       HorizontalOptions="Center">
                                    <Label Text="👨‍🍳" 
                                           FontSize="20" 
                                           TextColor="White" />
                                </Frame>
                                <Label Text="Recetas" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#92400E"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </Frame>

                        <!-- Presupuesto -->
                        <Frame Grid.Row="1" Grid.Column="1" 
                               BackgroundColor="#F3E8FF" 
                               HasShadow="False" 
                               CornerRadius="16" 
                               Padding="16"
                               HeightRequest="100">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="GoToGastos" />
                            </Frame.GestureRecognizers>
                            <StackLayout VerticalOptions="Center" 
                                       HorizontalOptions="Center" 
                                       Spacing="8">
                                <Frame BackgroundColor="#8B5CF6" 
                                       CornerRadius="20" 
                                       Padding="8" 
                                       HasShadow="False"
                                       HorizontalOptions="Center">
                                    <Label Text="💰" 
                                           FontSize="20" 
                                           TextColor="White" />
                                </Frame>
                                <Label Text="Gastos" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#6B21A8"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </Frame>
                    </Grid>
                </StackLayout>
            </Frame>

            <!-- Tips del día -->
            <Frame BackgroundColor="#E0F2FE" 
                   HasShadow="True" 
                   CornerRadius="16" 
                   Padding="20"
                   Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Frame Grid.Column="0" 
                           BackgroundColor="#0EA5E9" 
                           CornerRadius="20" 
                           Padding="10" 
                           HasShadow="False"
                           WidthRequest="40"
                           HeightRequest="40"
                           VerticalOptions="Start">
                        <Label Text="💡" 
                               FontSize="16" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                    </Frame>

                    <StackLayout Grid.Column="1" 
                                 VerticalOptions="Center" 
                                 Spacing="4"
                                 Margin="12,0,0,0">
                        <Label Text="Tip del día" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="#0C4A6E" />
                        <Label Text="Revisa regularmente las fechas de vencimiento para evitar desperdicios y mantener tu cocina organizada." 
                               FontSize="14" 
                               TextColor="#0369A1"
                               LineBreakMode="WordWrap" />
                    </StackLayout>
                </Grid>
            </Frame>

        </StackLayout>
    </ScrollView>
</ContentPage>
