<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.RegistroPage"
             BackgroundColor="#F8FAFC"
             Title="Registro de Usuario">

    <ScrollView>
        <StackLayout Spacing="24" Padding="24">

            <!-- Logo y Header -->
            <StackLayout Spacing="20" Margin="0,40,0,20">
                <Frame BackgroundColor="White" 
                       HasShadow="True" 
                       CornerRadius="30" 
                       Padding="20"
                       HorizontalOptions="Center">
                    <Image Source="logofridgeloop.png"
                           HorizontalOptions="Center"
                           HeightRequest="120"
                           WidthRequest="120" />
                </Frame>

                <StackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="¡Únete a FridgeLoop! 🌟" 
                           FontSize="26" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"
                           TextColor="#1F2937" />
                    <Label Text="Crea tu cuenta y comienza a gestionar tu cocina" 
                           FontSize="16" 
                           HorizontalOptions="Center"
                           TextColor="#6B7280"
                           HorizontalTextAlignment="Center" />
                </StackLayout>
            </StackLayout>

            <!-- Formulario de Registro -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   CornerRadius="20" 
                   Padding="24">
                <StackLayout Spacing="20">

                    <!-- Campo de Nombre -->
                    <StackLayout Spacing="8">
                        <Label Text="Nombre Completo" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               TextColor="#374151" />
                        <Frame BackgroundColor="#F8FAFC" 
                               HasShadow="False" 
                               CornerRadius="12" 
                               Padding="0"
                               HeightRequest="50">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Frame Grid.Column="0" 
                                       BackgroundColor="#10B981" 
                                       CornerRadius="8" 
                                       Padding="8" 
                                       HasShadow="False"
                                       VerticalOptions="Center"
                                       Margin="12,0,0,0">
                                    <Label Text="👤" 
                                           FontSize="14" 
                                           TextColor="White"
                                           HorizontalOptions="Center" />
                                </Frame>
                                <Entry x:Name="txtNombre"
                                       Grid.Column="1"
                                       Placeholder="Tu nombre y apellidos"
                                       FontSize="16"
                                       BackgroundColor="Transparent"
                                       TextColor="#1F2937"
                                       PlaceholderColor="#9CA3AF"
                                       Margin="0,0,16,0" />
                            </Grid>
                        </Frame>
                    </StackLayout>

                    <!-- Campo de Email -->
                    <StackLayout Spacing="8">
                        <Label Text="Correo Electrónico" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               TextColor="#374151" />
                        <Frame BackgroundColor="#F8FAFC" 
                               HasShadow="False" 
                               CornerRadius="12" 
                               Padding="0"
                               HeightRequest="50">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Frame Grid.Column="0" 
                                       BackgroundColor="#3B82F6" 
                                       CornerRadius="8" 
                                       Padding="8" 
                                       HasShadow="False"
                                       VerticalOptions="Center"
                                       Margin="12,0,0,0">
                                    <Label Text="📧" 
                                           FontSize="14" 
                                           TextColor="White"
                                           HorizontalOptions="Center" />
                                </Frame>
                                <Entry x:Name="txtCorreo"
                                       Grid.Column="1"
                                       Placeholder="tu@email.com"
                                       FontSize="16"
                                       Keyboard="Email"
                                       BackgroundColor="Transparent"
                                       TextColor="#1F2937"
                                       PlaceholderColor="#9CA3AF"
                                       Margin="0,0,16,0" />
                            </Grid>
                        </Frame>
                    </StackLayout>

                    <!-- Campo de Contraseña -->
                    <StackLayout Spacing="8">
                        <Label Text="Contraseña" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               TextColor="#374151" />
                        <Frame BackgroundColor="#F8FAFC" 
                               HasShadow="False" 
                               CornerRadius="12" 
                               Padding="0"
                               HeightRequest="50">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Frame Grid.Column="0" 
                                       BackgroundColor="#8B5CF6" 
                                       CornerRadius="8" 
                                       Padding="8" 
                                       HasShadow="False"
                                       VerticalOptions="Center"
                                       Margin="12,0,0,0">
                                    <Label Text="🔒" 
                                           FontSize="14" 
                                           TextColor="White"
                                           HorizontalOptions="Center" />
                                </Frame>
                                <Entry x:Name="txtPassword"
                                       Grid.Column="1"
                                       Placeholder="Crea una contraseña segura"
                                       FontSize="16"
                                       IsPassword="True"
                                       BackgroundColor="Transparent"
                                       TextColor="#1F2937"
                                       PlaceholderColor="#9CA3AF"
                                       Margin="0,0,16,0" />
                            </Grid>
                        </Frame>
                    </StackLayout>

                    <!-- Requisitos de contraseña -->
                    <Frame BackgroundColor="#FEF3C7" 
                           HasShadow="False" 
                           CornerRadius="8" 
                           Padding="12">
                        <StackLayout Orientation="Horizontal" Spacing="8">
                            <Label Text="💡" FontSize="14" />
                            <Label Text="Usa al menos 8 caracteres con letras, números y símbolos"
                                   FontSize="12"
                                   TextColor="#92400E"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap" />
                        </StackLayout>
                    </Frame>

                    <!-- Términos y condiciones -->
                    <StackLayout Spacing="12" Margin="0,8,0,0">
                        <StackLayout Orientation="Horizontal" 
                                   HorizontalOptions="Start"
                                   Spacing="12">
                            <CheckBox x:Name="chkAceptarTerminos" 
                                      Color="#3B82F6" 
                                      VerticalOptions="Center" />
                            <Label Text="Acepto los Términos y Políticas de Privacidad"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#374151"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap" />
                        </StackLayout>
                    </StackLayout>

                    <!-- Botón de Registro -->
                    <Frame BackgroundColor="#10B981" 
                           CornerRadius="25" 
                           Padding="0" 
                           HasShadow="True"
                           Margin="0,12,0,0">
                        <Button Text="🚀 Crear Mi Cuenta" 
                                BackgroundColor="Transparent"
                                TextColor="White"
                                FontSize="18"
                                FontAttributes="Bold"
                                HeightRequest="54"
                                Clicked="OnRegisterClicked" />
                    </Frame>

                </StackLayout>
            </Frame>

            <!-- Información adicional -->
            <StackLayout Spacing="16" Margin="0,8,0,40">

                <!-- Verificación por email -->
                <Frame BackgroundColor="#E0F2FE" 
                       HasShadow="False" 
                       CornerRadius="12" 
                       Padding="16">
                    <StackLayout Orientation="Horizontal" 
                               HorizontalOptions="Center"
                               Spacing="12">
                        <Frame BackgroundColor="#0EA5E9" 
                               CornerRadius="12" 
                               Padding="8" 
                               HasShadow="False">
                            <Label Text="📬" 
                                   FontSize="16" 
                                   TextColor="White"
                                   HorizontalOptions="Center" />
                        </Frame>
                        <StackLayout VerticalOptions="Center" Spacing="2">
                            <Label Text="Verificación por email"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#0C4A6E" />
                            <Label Text="Te enviaremos un código de verificación"
                                   FontSize="12"
                                   TextColor="#0369A1" />
                        </StackLayout>
                    </StackLayout>
                </Frame>

                <!-- Separador -->
                <StackLayout Orientation="Horizontal" 
                           HorizontalOptions="FillAndExpand"
                           Spacing="12"
                           Margin="20,16">
                    <BoxView HeightRequest="1" 
                             BackgroundColor="#E5E7EB" 
                             VerticalOptions="Center"
                             HorizontalOptions="FillAndExpand" />
                    <Label Text="o" 
                           FontSize="14" 
                           TextColor="#9CA3AF"
                           VerticalOptions="Center" />
                    <BoxView HeightRequest="1" 
                             BackgroundColor="#E5E7EB" 
                             VerticalOptions="Center"
                             HorizontalOptions="FillAndExpand" />
                </StackLayout>

                <!-- Ya tienes cuenta -->
                <Frame BackgroundColor="White" 
                       HasShadow="False" 
                       CornerRadius="12" 
                       Padding="16"
                       BorderColor="#E5E7EB">
                    <StackLayout Orientation="Horizontal" 
                               HorizontalOptions="Center"
                               Spacing="8">
                        <Label Text="🔑" FontSize="16" />
                        <Label Text="¿Ya tienes cuenta? "
                               FontSize="14"
                               TextColor="#6B7280"
                               VerticalOptions="Center" />
                        <Label Text="Inicia sesión aquí"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#3B82F6"
                               VerticalOptions="Center" />
                    </StackLayout>
                </Frame>

            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>