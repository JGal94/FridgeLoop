<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.ListaComprasPage"
             Title="Lista de Compras"
             BackgroundColor="#EAF4FF">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label Text="Lista de Compras"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#003366"/>

            <HorizontalStackLayout HorizontalOptions="End">
                <Button Text="📊 Ver historial de compras"
                        BackgroundColor="#667892"
                        TextColor="White"
                        CornerRadius="10"
                        Padding="14,8"
                        Clicked="OnVerHistorialClicked"/>
            </HorizontalStackLayout>

            <Label Text="Lista sugerida por la app"
                   FontSize="16"
                   TextColor="#003366"
                   Margin="0,6,0,0"/>

            <!-- Lista dinámica con swipe -->
            <Frame BackgroundColor="#FFFFFF"
                   CornerRadius="12"
                   Padding="6"
                   HasShadow="True">

                <CollectionView x:Name="cvLista"
                                SelectionMode="None">
                    <!-- Mensaje cuando está vacía -->
                    <CollectionView.EmptyView>
                        <Grid Padding="16">
                            <Label Text="— Sin productos —"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   FontSize="16"
                                   TextColor="#667892"/>
                        </Grid>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItem Text="Editar"
                                                   BackgroundColor="#007ACC"
                                                   Invoked="OnEditarItem"
                                                   CommandParameter="{Binding .}" />
                                        <SwipeItem Text="Eliminar"
                                                   BackgroundColor="#D9534F"
                                                   Invoked="OnEliminarItem"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <!-- Tarjeta del item -->
                                <!-- Tarjeta del item -->
                                <Grid Padding="10"
      ColumnDefinitions="*,Auto"
      RowDefinitions="Auto,Auto">

                                    <!-- Nombre -->
                                    <Label Grid.Row="0" Grid.Column="0"
         Text="{Binding Nombre}"
         FontSize="17"
         TextColor="#003366"
         LineBreakMode="TailTruncation"/>

                                    <!-- Presentación (para kg/g/ml/L) -->
                                    <Label Grid.Row="1" Grid.Column="0"
         FontSize="15"
         TextColor="#335"
         IsVisible="True">
                                        <Label.Text>
                                            <MultiBinding StringFormat="Presentación: {0:0.##} {1}">
                                                <Binding Path="Cantidad"/>
                                                <Binding Path="Unidad"/>
                                            </MultiBinding>
                                        </Label.Text>
                                        <!-- Ocultar si es pieza/unidad/pack -->
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Unidad}" Value="pz">
                                                <Setter Property="IsVisible" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Unidad}" Value="unid">
                                                <Setter Property="IsVisible" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Unidad}" Value="pack">
                                                <Setter Property="IsVisible" Value="False"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <!-- Cantidad de productos (solo pz/unid/pack) -->
                                    <Label Grid.Row="1" Grid.Column="0"
         FontSize="15"
         TextColor="#335"
         IsVisible="False">
                                        <Label.Text>
                                            <!-- muestralo como: Cantidad: ×2 -->
                                            <Binding Path="Cantidad" StringFormat="Cantidad: ×{0:0}"/>
                                        </Label.Text>
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Unidad}" Value="pz">
                                                <Setter Property="IsVisible" Value="True"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Unidad}" Value="unid">
                                                <Setter Property="IsVisible" Value="True"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Unidad}" Value="pack">
                                                <Setter Property="IsVisible" Value="True"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <!-- Precio a la derecha -->
                                    <VerticalStackLayout Grid.RowSpan="2" Grid.Column="1"
                       HorizontalOptions="End"
                       Spacing="2"
                       Margin="12,0,4,0">
                                        <Label Text="Precio unitario"
           FontSize="12"
           TextColor="#666"
           HorizontalTextAlignment="End" />
                                        <Label FontSize="15"
           TextColor="#335"
           HorizontalTextAlignment="End">
                                            <Label.Text>
                                                <Binding Path="PrecioUnitario"
                 StringFormat="₡{0:N0}"
                 TargetNullValue="—" />
                                            </Label.Text>
                                        </Label>
                                    </VerticalStackLayout>

                                </Grid>


                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                
            </Frame>
            <Border BackgroundColor="#FFFFFF" Stroke="#E5E7EB" Padding="14" StrokeShape="RoundRectangle 12">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Text="Total de la compra" FontSize="13" TextColor="#64748B" />
                    <Label x:Name="lblTotal"
           Grid.Column="1"
           FontAttributes="Bold"
           FontSize="18"
           TextColor="#0F172A"
           HorizontalTextAlignment="End"
           HorizontalOptions="End" />
                </Grid>
            </Border>


            <!-- Botones -->
            <Button Text="➕ Agregar producto"
                    BackgroundColor="#28A745"
                    TextColor="White"
                    FontSize="18"
                    CornerRadius="10"
                    Clicked="OnAgregarProductoClicked" />

            <Button Text="Realizar compra"
                    BackgroundColor="#007ACC"
                    TextColor="White"
                    FontSize="18"
                    CornerRadius="10"
                    Clicked="OnRealizarCompraClicked" />

            <Button Text="🗑️ Vaciar lista"
        BackgroundColor="#D9534F"
        TextColor="White"
        FontSize="18"
        CornerRadius="10"
        Clicked="OnVaciarListaClicked" />


            <Button Text="🔄 Sincronizar con apps"
                    BackgroundColor="#FFAA1A"
                    TextColor="White"
                    FontSize="18"
                    CornerRadius="10"
                    Clicked="OnSincronizarClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
