<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.DetalleProductoPage"
             Title="Detalle del Producto"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <StackLayout Spacing="20" Padding="20">

            <!-- Header con botón de regreso -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Frame Grid.Column="0" 
                       BackgroundColor="White" 
                       CornerRadius="20" 
                       Padding="0" 
                       HasShadow="True"
                       WidthRequest="44"
                       HeightRequest="44"
                       VerticalOptions="Center">
                    <Button Text="←"
                            BackgroundColor="Transparent"
                            TextColor="#6B7280"
                            FontSize="18"
                            FontAttributes="Bold" />
                </Frame>

                <Frame Grid.Column="1" 
                       BackgroundColor="White" 
                       HasShadow="True" 
                       CornerRadius="20" 
                       Padding="24"
                       Margin="12,0,0,0">
                    <StackLayout Orientation="Horizontal" Spacing="16">
                        <Frame BackgroundColor="#F59E0B" 
                               CornerRadius="25" 
                               Padding="12" 
                               HasShadow="False"
                               WidthRequest="50"
                               HeightRequest="50">
                            <Label Text="📦" 
                                   FontSize="20" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" />
                        </Frame>
                        <StackLayout VerticalOptions="Center" Spacing="4">
                            <Label Text="Detalle del Producto" 
                                   FontSize="22" 
                                   FontAttributes="Bold" 
                                   TextColor="#1F2937" />
                            <Label Text="Gestiona tu inventario personal" 
                                   FontSize="14" 
                                   TextColor="#6B7280" />
                        </StackLayout>
                    </StackLayout>
                </Frame>
            </Grid>

            <!-- Información del Producto -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   CornerRadius="16" 
                   Padding="24">
                <StackLayout Spacing="20">
                    <StackLayout Orientation="Horizontal" 
                                 Spacing="12">
                        <Label Text="🏷️" FontSize="18" />
                        <Label Text="Información del Producto" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#1F2937" />
                    </StackLayout>

                    <!-- Separador -->
                    <BoxView HeightRequest="1" 
                             BackgroundColor="#F3F4F6" 
                             HorizontalOptions="FillAndExpand" />

                    <StackLayout Spacing="12">
                        <Label Text="Nombre del Producto" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               TextColor="#374151" />
                        <Frame BackgroundColor="#E0F2FE" 
                               HasShadow="False" 
                               CornerRadius="12" 
                               Padding="16"
                               HeightRequest="56">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Frame Grid.Column="0" 
                                       BackgroundColor="#0EA5E9" 
                                       CornerRadius="8" 
                                       Padding="8" 
                                       HasShadow="False"
                                       VerticalOptions="Center">
                                    <Label Text="📝" 
                                           FontSize="14" 
                                           TextColor="White"
                                           HorizontalOptions="Center" />
                                </Frame>
                                <Entry x:Name="txtNombre"
                                       Grid.Column="1"
                                       Placeholder="Nombre del producto"
                                       BackgroundColor="Transparent"
                                       TextColor="#0C4A6E"
                                       PlaceholderColor="#64748B"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       IsReadOnly="True"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- Gestión de Inventario Personal -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   CornerRadius="16" 
                   Padding="24">
                <StackLayout Spacing="20">
                    <StackLayout Orientation="Horizontal" 
                                 Spacing="12">
                        <Label Text="📊" FontSize="18" />
                        <Label Text="Tu Inventario Personal" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#1F2937" />
                    </StackLayout>

                    <!-- Separador -->
                    <BoxView HeightRequest="1" 
                             BackgroundColor="#F3F4F6" 
                             HorizontalOptions="FillAndExpand" />

                    <!-- Cantidad disponible -->
                    <StackLayout Spacing="12">
                        <Label Text="Cantidad Disponible" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               TextColor="#374151" />
                        <Frame BackgroundColor="#F0FDF4" 
                               HasShadow="False" 
                               CornerRadius="12" 
                               Padding="16"
                               HeightRequest="56">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Frame Grid.Column="0" 
                                       BackgroundColor="#10B981" 
                                       CornerRadius="8" 
                                       Padding="8" 
                                       HasShadow="False"
                                       VerticalOptions="Center">
                                    <Label Text="📈" 
                                           FontSize="14" 
                                           TextColor="White"
                                           HorizontalOptions="Center" />
                                </Frame>
                                <Entry x:Name="txtCantidad"
                                       Grid.Column="1"
                                       Placeholder="Ej: 2.5"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent"
                                       TextColor="#064E3B"
                                       PlaceholderColor="#64748B"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <Frame Grid.Column="2" 
                                       BackgroundColor="#DCFCE7" 
                                       CornerRadius="8" 
                                       Padding="8,4" 
                                       HasShadow="False"
                                       VerticalOptions="Center">
                                    <Label Text="unidades" 
                                           FontSize="12" 
                                           FontAttributes="Bold"
                                           TextColor="#16A34A"
                                           HorizontalOptions="Center" />
                                </Frame>
                            </Grid>
                        </Frame>
                    </StackLayout>

                    <!-- Fecha de expiración -->
                    <StackLayout Spacing="12">
                        <Label Text="Fecha de Expiración" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               TextColor="#374151" />
                        <Frame BackgroundColor="#FEF3C7" 
                               HasShadow="False" 
                               CornerRadius="12" 
                               Padding="16"
                               HeightRequest="56">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Frame Grid.Column="0" 
                                       BackgroundColor="#F59E0B" 
                                       CornerRadius="8" 
                                       Padding="8" 
                                       HasShadow="False"
                                       VerticalOptions="Center">
                                    <Label Text="📅" 
                                           FontSize="14" 
                                           TextColor="White"
                                           HorizontalOptions="Center" />
                                </Frame>
                                <DatePicker x:Name="dpExpira" 
                                            Grid.Column="1"
                                            BackgroundColor="Transparent"
                                            TextColor="#92400E"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            VerticalOptions="Center" />
                                <Frame Grid.Column="2" 
                                       BackgroundColor="#FEF3C7" 
                                       CornerRadius="8" 
                                       Padding="8,4" 
                                       HasShadow="False"
                                       VerticalOptions="Center">
                                    <Label Text="📆" 
                                           FontSize="14" 
                                           TextColor="#D97706"
                                           HorizontalOptions="Center" />
                                </Frame>
                            </Grid>
                        </Frame>
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- Estado del Inventario -->
            <Frame BackgroundColor="#F3E8FF" 
                   HasShadow="True" 
                   CornerRadius="16" 
                   Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Frame Grid.Column="0" 
                           BackgroundColor="#8B5CF6" 
                           CornerRadius="20" 
                           Padding="10" 
                           HasShadow="False"
                           WidthRequest="40"
                           HeightRequest="40">
                        <Label Text="💡" 
                               FontSize="16" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                    </Frame>

                    <StackLayout Grid.Column="1" 
                                 VerticalOptions="Center" 
                                 Spacing="2"
                                 Margin="12,0">
                        <Label Text="Estado del Inventario" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               TextColor="#6B21A8" />
                        <Label Text="Actualiza la información para mantener control preciso" 
                               FontSize="12" 
                               TextColor="#9333EA" />
                    </StackLayout>

                    <Frame Grid.Column="2" 
                           BackgroundColor="White" 
                           CornerRadius="12" 
                           Padding="8,4" 
                           HasShadow="False"
                           VerticalOptions="Center">
                        <Label Text="📋" 
                               FontSize="16" 
                               HorizontalOptions="Center" />
                    </Frame>
                </Grid>
            </Frame>

            <!-- Estadísticas rápidas -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   CornerRadius="16" 
                   Padding="20">
                <StackLayout Spacing="16">
                    <StackLayout Orientation="Horizontal" 
                                 Spacing="12">
                        <Label Text="📈" FontSize="16" />
                        <Label Text="Estadísticas" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="#1F2937" />
                    </StackLayout>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Última actualización -->
                        <Frame Grid.Column="0" 
                               BackgroundColor="#E0F2FE" 
                               HasShadow="False" 
                               CornerRadius="8" 
                               Padding="12">
                            <StackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="🕒" FontSize="16" HorizontalOptions="Center" />
                                <Label Text="Última" 
                                       FontSize="10" 
                                       TextColor="#0369A1"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Actualización" 
                                       FontSize="10" 
                                       TextColor="#0369A1"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </Frame>

                        <!-- Estado -->
                        <Frame Grid.Column="1" 
                               BackgroundColor="#F0FDF4" 
                               HasShadow="False" 
                               CornerRadius="8" 
                               Padding="12">
                            <StackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="✅" FontSize="16" HorizontalOptions="Center" />
                                <Label Text="Estado" 
                                       FontSize="10" 
                                       TextColor="#059669"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Disponible" 
                                       FontSize="10" 
                                       TextColor="#059669"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </Frame>

                        <!-- Días restantes -->
                        <Frame Grid.Column="2" 
                               BackgroundColor="#FEF3C7" 
                               HasShadow="False" 
                               CornerRadius="8" 
                               Padding="12">
                            <StackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="⏰" FontSize="16" HorizontalOptions="Center" />
                                <Label Text="Días" 
                                       FontSize="10" 
                                       TextColor="#D97706"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Restantes" 
                                       FontSize="10" 
                                       TextColor="#D97706"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </Frame>
                    </Grid>
                </StackLayout>
            </Frame>

            <!-- Botones de Acción -->
            <StackLayout Spacing="12" Margin="0,8,0,40">

                <!-- Actualizar inventario -->
                <Frame BackgroundColor="#10B981" 
                       CornerRadius="25" 
                       Padding="0" 
                       HasShadow="True">
                    <Button Text="✅ Actualizar Inventario" 
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="18"
                            FontAttributes="Bold"
                            HeightRequest="56"
                            Clicked="OnActualizarInventarioClicked" />
                </Frame>

                <!-- Opciones adicionales -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Historial -->
                    <Frame Grid.Column="0" 
                           BackgroundColor="White" 
                           CornerRadius="16" 
                           Padding="0" 
                           HasShadow="False"
                           BorderColor="#8B5CF6">
                        <Button Text="📊 Historial" 
                                BackgroundColor="Transparent"
                                TextColor="#8B5CF6"
                                FontSize="14"
                                FontAttributes="Bold"
                                HeightRequest="48" />
                    </Frame>

                    <!-- Eliminar -->
                    <Frame Grid.Column="1" 
                           BackgroundColor="White" 
                           CornerRadius="16" 
                           Padding="0" 
                           HasShadow="False"
                           BorderColor="#EF4444">
                        <Button Text="🗑️ Eliminar" 
                                BackgroundColor="Transparent"
                                TextColor="#EF4444"
                                FontSize="14"
                                FontAttributes="Bold"
                                HeightRequest="48" />
                    </Frame>
                </Grid>

            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>