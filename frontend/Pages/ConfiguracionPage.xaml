<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.ConfiguracionPage"
             Title="Configuración"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <StackLayout Spacing="20" Padding="20">

            <!-- Header Principal -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   CornerRadius="20" 
                   Padding="24"
                   Margin="0,0,0,8">
                <StackLayout Orientation="Horizontal" Spacing="16">
                    <Frame BackgroundColor="#6B7280" 
                           CornerRadius="25" 
                           Padding="12" 
                           HasShadow="False"
                           WidthRequest="50"
                           HeightRequest="50">
                        <Label Text="⚙️" 
                               FontSize="20" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                    </Frame>
                    <StackLayout VerticalOptions="Center" Spacing="4">
                        <Label Text="Configuración" 
                               FontSize="22" 
                               FontAttributes="Bold" 
                               TextColor="#1F2937" />
                        <Label Text="Personaliza tu experiencia" 
                               FontSize="14" 
                               TextColor="#6B7280" />
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- Logo de la app -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   CornerRadius="20" 
                   Padding="24"
                   HorizontalOptions="Center">
                <StackLayout HorizontalOptions="Center" Spacing="12">
                    <Image Source="logofridgeloop.png"
                           HorizontalOptions="Center"
                           HeightRequest="100"
                           WidthRequest="100" />
                    <Label Text="FridgeLoop v1.0" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="#1F2937"
                           HorizontalOptions="Center" />
                    <Label Text="Tu asistente inteligente de cocina" 
                           FontSize="12" 
                           TextColor="#6B7280"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Frame>

            <!-- Sección de Integraciones -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   CornerRadius="16" 
                   Padding="20">
                <StackLayout Spacing="16">
                    <StackLayout Orientation="Horizontal" 
                                 Spacing="12">
                        <Label Text="🔗" FontSize="16" />
                        <Label Text="Integraciones" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#1F2937" />
                    </StackLayout>

                    <!-- Sincronización con apps -->
                    <Frame BackgroundColor="#E0F2FE" 
                           HasShadow="False" 
                           CornerRadius="12" 
                           Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Frame Grid.Column="0" 
                                   BackgroundColor="#0EA5E9" 
                                   CornerRadius="12" 
                                   Padding="8" 
                                   HasShadow="False"
                                   VerticalOptions="Center">
                                <Label Text="📱" 
                                       FontSize="16" 
                                       TextColor="White"
                                       HorizontalOptions="Center" />
                            </Frame>

                            <StackLayout Grid.Column="1" 
                                       VerticalOptions="Center" 
                                       Spacing="4"
                                       Margin="12,0">
                                <Label Text="Apps de Delivery y Supermercados" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#0C4A6E" />
                                <Label Text="Conecta con tus apps favoritas de compras" 
                                       FontSize="12" 
                                       TextColor="#0369A1" />
                            </StackLayout>

                            <Switch Grid.Column="2" 
                                    OnColor="#0EA5E9"
                                    ThumbColor="White"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </StackLayout>
            </Frame>

            <!-- Sección de Cuenta y Sesión -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   CornerRadius="16" 
                   Padding="20">
                <StackLayout Spacing="16">
                    <StackLayout Orientation="Horizontal" 
                                 Spacing="12">
                        <Label Text="👤" FontSize="16" />
                        <Label Text="Cuenta y Sesión" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#1F2937" />
                    </StackLayout>

                    <!-- Gestión de dispositivos -->
                    <Frame BackgroundColor="#FEF3C7" 
                           HasShadow="False" 
                           CornerRadius="12" 
                           Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Frame Grid.Column="0" 
                                   BackgroundColor="#F59E0B" 
                                   CornerRadius="12" 
                                   Padding="8" 
                                   HasShadow="False"
                                   VerticalOptions="Center">
                                <Label Text="📱" 
                                       FontSize="16" 
                                       TextColor="White"
                                       HorizontalOptions="Center" />
                            </Frame>

                            <StackLayout Grid.Column="1" 
                                       VerticalOptions="Center" 
                                       Spacing="4"
                                       Margin="12,0">
                                <Label Text="Dispositivos Conectados" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#92400E" />
                                <Label Text="Gestiona sesiones activas y dispositivos" 
                                       FontSize="12" 
                                       TextColor="#B45309" />
                            </StackLayout>

                            <Frame Grid.Column="2" 
                                   BackgroundColor="White" 
                                   CornerRadius="8" 
                                   Padding="8,4" 
                                   HasShadow="False"
                                   VerticalOptions="Center">
                                <Label Text="→" 
                                       FontSize="16" 
                                       TextColor="#F59E0B"
                                       HorizontalOptions="Center" />
                            </Frame>
                        </Grid>
                    </Frame>
                </StackLayout>
            </Frame>

            <!-- Sección de Privacidad y Seguridad -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   CornerRadius="16" 
                   Padding="20">
                <StackLayout Spacing="16">
                    <StackLayout Orientation="Horizontal" 
                                 Spacing="12">
                        <Label Text="🔒" FontSize="16" />
                        <Label Text="Privacidad y Seguridad" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#1F2937" />
                    </StackLayout>

                    <!-- Política de privacidad -->
                    <Frame BackgroundColor="#FEE2E2" 
                           HasShadow="False" 
                           CornerRadius="12" 
                           Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Frame Grid.Column="0" 
                                   BackgroundColor="#EF4444" 
                                   CornerRadius="12" 
                                   Padding="8" 
                                   HasShadow="False"
                                   VerticalOptions="Center">
                                <Label Text="📋" 
                                       FontSize="16" 
                                       TextColor="White"
                                       HorizontalOptions="Center" />
                            </Frame>

                            <StackLayout Grid.Column="1" 
                                       VerticalOptions="Center" 
                                       Spacing="4"
                                       Margin="12,0">
                                <Label Text="Política de Privacidad" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#991B1B" />
                                <Label Text="Revisa cómo protegemos tus datos" 
                                       FontSize="12" 
                                       TextColor="#B91C1C" />
                            </StackLayout>

                            <Frame Grid.Column="2" 
                                   BackgroundColor="White" 
                                   CornerRadius="8" 
                                   Padding="8,4" 
                                   HasShadow="False"
                                   VerticalOptions="Center">
                                <Label Text="→" 
                                       FontSize="16" 
                                       TextColor="#EF4444"
                                       HorizontalOptions="Center" />
                            </Frame>
                        </Grid>
                    </Frame>

                    <!-- Cerrar sesión -->
                    <Frame BackgroundColor="#F3F4F6" 
                           HasShadow="False" 
                           CornerRadius="12" 
                           Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Frame Grid.Column="0" 
                                   BackgroundColor="#6B7280" 
                                   CornerRadius="12" 
                                   Padding="8" 
                                   HasShadow="False"
                                   VerticalOptions="Center">
                                <Label Text="🚪" 
                                       FontSize="16" 
                                       TextColor="White"
                                       HorizontalOptions="Center" />
                            </Frame>

                            <StackLayout Grid.Column="1" 
                                       VerticalOptions="Center" 
                                       Spacing="4"
                                       Margin="12,0">
                                <Label Text="Cerrar Sesión" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#374151" />
                                <Label Text="Sal de tu cuenta en este dispositivo" 
                                       FontSize="12" 
                                       TextColor="#6B7280" />
                            </StackLayout>

                            <Frame Grid.Column="2" 
                                   BackgroundColor="White" 
                                   CornerRadius="8" 
                                   Padding="8,4" 
                                   HasShadow="False"
                                   VerticalOptions="Center">
                                <Label Text="→" 
                                       FontSize="16" 
                                       TextColor="#6B7280"
                                       HorizontalOptions="Center" />
                            </Frame>
                        </Grid>
                    </Frame>
                </StackLayout>
            </Frame>

            <!-- Ajustes Avanzados -->
            <StackLayout Spacing="12" Margin="0,8,0,40">
                <Frame BackgroundColor="#8B5CF6" 
                       CornerRadius="25" 
                       Padding="0" 
                       HasShadow="True">
                    <Button Text="⚡ Ajustes Avanzados" 
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="54"
                            Clicked="OnAvanzadoClicked" />
                </Frame>

                <!-- Información de versión -->
                <StackLayout Spacing="8" HorizontalOptions="Center" Margin="0,20,0,0">
                    <Label Text="Información de la App" 
                           FontSize="14" 
                           FontAttributes="Bold" 
                           TextColor="#6B7280"
                           HorizontalOptions="Center" />
                    <Label Text="Versión 1.0.0 • Construido con .NET MAUI" 
                           FontSize="12" 
                           TextColor="#9CA3AF"
                           HorizontalOptions="Center" />
                    <Label Text="© 2024 FridgeLoop Team" 
                           FontSize="11" 
                           TextColor="#9CA3AF"
                           HorizontalOptions="Center" />
                </StackLayout>
            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>