<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.PresupuestoMensualPage"
             Title="Presupuesto Mensual"
             BackgroundColor="#EAF4FF">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Start">

            <Image Source="logofridgeloop.png"
                   HorizontalOptions="Center"
                   HeightRequest="200"
                   Margin="0,10,0,10" />

            <Label Text="Control de gasto mensual"
                   FontSize="22"
                   FontFamily="OpenSansBold"
                   TextColor="#003366" />

            <!-- Campo: definir presupuesto -->
            <Frame BackgroundColor="#D6F0FF" CornerRadius="8">
                <Entry Placeholder="Monto máximo (₡)"
                       FontSize="16"
                       Keyboard="Numeric"
                       BackgroundColor="Transparent"
                       TextColor="#003366" />
            </Frame>

            <!-- Progreso (simulado) -->
            <Frame BackgroundColor="White" CornerRadius="8" Padding="15" HasShadow="True">
                <VerticalStackLayout>
                    <Label Text="Gasto actual: ₡32,000"
                           FontSize="16"
                           TextColor="#003366" />
                    <ProgressBar Progress="0.64"
                                 ProgressColor="#007ACC"
                                 HeightRequest="10"
                                 Margin="0,5,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Alerta -->
            <Frame BackgroundColor="#FFF0F0" CornerRadius="8" Padding="10">
                <Label Text="⚠️ Estás cerca de tu límite mensual"
                       FontSize="14"
                       TextColor="#D9534F" />
            </Frame>

            <!-- Estadísticas básicas -->
            <Frame BackgroundColor="#FFFFFF" CornerRadius="12" Padding="15" HasShadow="True">
                <VerticalStackLayout>
                    <Label Text="Estadísticas:"
                           FontSize="16"
                           FontFamily="OpenSansSemiBold"
                           TextColor="#004C99" />

                    <Label Text="• Total del mes pasado: ₡38,500"
                           FontSize="14"
                           TextColor="#666" />

                    <Label Text="• Promedio diario: ₡1,283"
                           FontSize="14"
                           TextColor="#666" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
