<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.VerificacionPage"
             BackgroundColor="#F8FAFC"
             Title="Verificación de Cuenta">

    <ScrollView>
        <StackLayout Spacing="24" Padding="24">

            <!-- Header con botón de regreso -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Frame Grid.Column="0" 
                       BackgroundColor="White" 
                       CornerRadius="20" 
                       Padding="0" 
                       HasShadow="True"
                       WidthRequest="44"
                       HeightRequest="44">
                    <ImageButton Source="arrow_back.png"
                                 BackgroundColor="Transparent"
                                 WidthRequest="24"
                                 HeightRequest="24"
                                 Clicked="OnBackClicked" />
                </Frame>
            </Grid>

            <!-- Icono principal y título -->
            <StackLayout Spacing="20" Margin="0,20,0,20" HorizontalOptions="Center">
                <Frame BackgroundColor="White" 
                       HasShadow="True" 
                       CornerRadius="30" 
                       Padding="24"
                       HorizontalOptions="Center">
                    <Frame BackgroundColor="#10B981" 
                           CornerRadius="25" 
                           Padding="16" 
                           HasShadow="False"
                           WidthRequest="80"
                           HeightRequest="80">
                        <Label Text="✉️" 
                               FontSize="32" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                    </Frame>
                </Frame>

                <StackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="Verifica tu cuenta 🔐" 
                           FontSize="26" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"
                           TextColor="#1F2937" />
                    <Label Text="Te enviamos un código de seguridad a tu correo electrónico" 
                           FontSize="16" 
                           HorizontalOptions="Center"
                           TextColor="#6B7280"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                </StackLayout>
            </StackLayout>

            <!-- Card principal de verificación -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   CornerRadius="20" 
                   Padding="24">
                <StackLayout Spacing="20">

                    <!-- Instrucciones -->
                    <Frame BackgroundColor="#E0F2FE" 
                           HasShadow="False" 
                           CornerRadius="12" 
                           Padding="16">
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Frame BackgroundColor="#0EA5E9" 
                                   CornerRadius="12" 
                                   Padding="8" 
                                   HasShadow="False"
                                   VerticalOptions="Start">
                                <Label Text="📬" 
                                       FontSize="16" 
                                       TextColor="White"
                                       HorizontalOptions="Center" />
                            </Frame>
                            <StackLayout VerticalOptions="Center" Spacing="4">
                                <Label Text="Revisa tu bandeja de entrada" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#0C4A6E" />
                                <Label Text="El código llegará en los próximos minutos" 
                                       FontSize="12" 
                                       TextColor="#0369A1" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>

                    <!-- Campo de código -->
                    <StackLayout Spacing="8">
                        <Label Text="Código de Verificación" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               TextColor="#374151" />
                        <Frame BackgroundColor="#F8FAFC" 
                               HasShadow="False" 
                               CornerRadius="12" 
                               Padding="0"
                               HeightRequest="60">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Frame Grid.Column="0" 
                                       BackgroundColor="#F59E0B" 
                                       CornerRadius="10" 
                                       Padding="10" 
                                       HasShadow="False"
                                       VerticalOptions="Center"
                                       Margin="12,0,0,0">
                                    <Label Text="🔢" 
                                           FontSize="18" 
                                           TextColor="White"
                                           HorizontalOptions="Center" />
                                </Frame>
                                <Entry x:Name="txtCodigo"
                                       Grid.Column="1"
                                       Placeholder="Ingresa el código de 6 dígitos"
                                       FontSize="18"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent"
                                       TextColor="#1F2937"
                                       PlaceholderColor="#9CA3AF"
                                       HorizontalTextAlignment="Center"
                                       FontAttributes="Bold"
                                       Margin="0,0,16,0"
                                       MaxLength="6" />
                            </Grid>
                        </Frame>
                    </StackLayout>

                    <!-- Botón de activar -->
                    <Frame BackgroundColor="#10B981" 
                           CornerRadius="25" 
                           Padding="0" 
                           HasShadow="True"
                           Margin="0,12,0,0">
                        <Button Text="🚀 Activar Cuenta" 
                                BackgroundColor="Transparent"
                                TextColor="White"
                                FontSize="18"
                                FontAttributes="Bold"
                                HeightRequest="54"
                                Clicked="OnActivateClicked" />
                    </Frame>

                </StackLayout>
            </Frame>

            <!-- Opciones adicionales -->
            <StackLayout Spacing="12" Margin="0,8,0,40">

                <!-- ¿No recibiste el código? -->
                <Frame BackgroundColor="#FEF3C7" 
                       HasShadow="False" 
                       CornerRadius="12" 
                       Padding="16">
                    <StackLayout Spacing="8">
                        <StackLayout Orientation="Horizontal" 
                                   HorizontalOptions="Center"
                                   Spacing="8">
                            <Label Text="❓" FontSize="16" />
                            <Label Text="¿No recibiste el código?"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#92400E"
                                   VerticalOptions="Center" />
                        </StackLayout>
                        <Label Text="Revisa tu carpeta de spam o solicita un nuevo código"
                               FontSize="12"
                               TextColor="#B45309"
                               HorizontalTextAlignment="Center" />
                    </StackLayout>
                </Frame>

                <!-- Reenviar código -->
                <Frame BackgroundColor="White" 
                       HasShadow="False" 
                       CornerRadius="12" 
                       Padding="16"
                       BorderColor="#E5E7EB">
                    <StackLayout Orientation="Horizontal" 
                               HorizontalOptions="Center"
                               Spacing="8">
                        <Label Text="🔄" FontSize="16" />
                        <Label Text="Reenviar código de verificación"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#3B82F6"
                               VerticalOptions="Center" />
                    </StackLayout>
                </Frame>

                <!-- Timer o estado -->
                <Frame BackgroundColor="#F3F4F6" 
                       HasShadow="False" 
                       CornerRadius="12" 
                       Padding="12">
                    <StackLayout Orientation="Horizontal" 
                               HorizontalOptions="Center"
                               Spacing="8">
                        <Label Text="⏱️" FontSize="14" />
                        <Label Text="Puedes solicitar un nuevo código en 60 segundos"
                               FontSize="12"
                               TextColor="#6B7280"
                               VerticalOptions="Center" />
                    </StackLayout>
                </Frame>

            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>