<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.RecetasSugeridasPage"
             Title="Recetas sugeridas"
             BackgroundColor="#EAF4FF">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="Recetas sugeridas por IA"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#003366"/>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label x:Name="lblEstado"
                       Text="Pulsa el botón para generar recetas."
                       FontSize="14"
                       TextColor="#335"/>
                <Button x:Name="btnGenerar"
                        Grid.Column="1"
                        Text="🍳 Generar"
                        BackgroundColor="#007ACC"
                        TextColor="White"
                        CornerRadius="10"
                        Padding="12,8"
                        Clicked="OnGenerarClicked"/>
            </Grid>

            <ActivityIndicator x:Name="ai"
                               IsVisible="False"
                               IsRunning="False"
                               Color="#007ACC" />

            <CollectionView x:Name="cv"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Grid Padding="16">
                        <Label Text="— Aún no hay recetas —"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               TextColor="#667892"/>
                    </Grid>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="White"
                               CornerRadius="12"
                               Padding="12"
                               Margin="0,6"
                               HasShadow="True">
                            <VerticalStackLayout Spacing="6">
                                <!-- Nombre -->
                                <Label Text="{Binding Name}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#003366"/>

                                <!-- Descripción -->
                                <Label Text="{Binding Description}"
                                       FontSize="14"
                                       TextColor="#334"/>

                                <!-- Chips: tiempo / dificultad / calorías -->
                                <HorizontalStackLayout Spacing="8">
                                    <Frame BackgroundColor="#E6F2FF" Padding="8,4" CornerRadius="8">
                                        <Label Text="{Binding PreparationTime, StringFormat='⏱ {0} min'}"
                                               FontSize="12"
                                               TextColor="#003366"/>
                                    </Frame>
                                    <Frame BackgroundColor="#FFF8E1" Padding="8,4" CornerRadius="8">
                                        <Label Text="{Binding Difficulty, StringFormat='🎚 {0}'}"
                                               FontSize="12"
                                               TextColor="#665500"/>
                                    </Frame>
                                    <Frame BackgroundColor="#FFE6E6" Padding="8,4" CornerRadius="8">
                                        <Label Text="{Binding Calories, StringFormat='🔥 {0} kcal'}"
                                               FontSize="12"
                                               TextColor="#8A1F1F"/>
                                    </Frame>
                                </HorizontalStackLayout>

                                <!-- Ingredientes (multilínea) -->
                                <Label FontSize="13" TextColor="#335">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Ingredientes: " FontAttributes="Bold"/>
                                            <Span Text="{Binding Ingredients, Converter={x:Reference Name=conv}, ConverterParameter=line}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <!-- Botones -->
                                <HorizontalStackLayout Spacing="10">
                                    <Button Text="Preparar"
                                            BackgroundColor="#28A745"
                                            TextColor="White"
                                            CornerRadius="10"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnPrepararClicked"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Converter inline (sin tocar App.xaml): simple binding proxy -->
            <ContentView x:Name="conv" IsVisible="False"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
