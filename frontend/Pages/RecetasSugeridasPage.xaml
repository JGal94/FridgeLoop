<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Frontend_Proyecto_Fridgeloop.Pages.RecetasSugeridasPage"
             Title="Recetas Sugeridas"
             BackgroundColor="#EAF4FF">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Start">

            <Image Source="logofridgeloop.png"
                   HorizontalOptions="Center"
                   HeightRequest="200"
                   Margin="0,10,0,10" />

            <!-- Botón para historial -->
            <Button Text="📜 Ver historial de recetas"
                    BackgroundColor="#5A738E"
                    TextColor="White"
                    FontSize="16"
                    CornerRadius="10"
                    Clicked="OnVerHistorialClicked" />

            <Label Text="Recetas sugeridas según tu inventario"
                   FontSize="20"
                   FontFamily="OpenSansBold"
                   TextColor="#003366" />

            <!-- Filtros -->
            <HorizontalStackLayout Spacing="10">
                <Button Text="⏱ Tiempo" Clicked="OnFiltroTiempo"
                        BackgroundColor="#D6C8FF" TextColor="#333" CornerRadius="10" />
                <Button Text="🔥 Calorías" Clicked="OnFiltroCalorias"
                        BackgroundColor="#D6C8FF" TextColor="#333" CornerRadius="10" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <Button Text="🥦 Vegano" Clicked="OnFiltroVegano"
                        BackgroundColor="#D6C8FF" TextColor="#333" CornerRadius="10" />
                <Button Text="💪 Keto" Clicked="OnFiltroKeto"
                        BackgroundColor="#D6C8FF" TextColor="#333" CornerRadius="10" />
            </HorizontalStackLayout>

            <!-- Receta visible -->
            <Frame BackgroundColor="White"
                   CornerRadius="12"
                   Padding="15"
                   HasShadow="True"
                   Margin="0,10">
                <VerticalStackLayout>
                    <Label Text="🥗 Ensalada con atún"
                           FontSize="18"
                           FontFamily="OpenSansSemiBold"
                           TextColor="#004C99" />

                    <Label Text="Tiempo: 10 min | Calorías: 200"
                           FontSize="14"
                           TextColor="#666" />

                    <Label Text="Estilo: Keto"
                           FontSize="14"
                           TextColor="#666" />

                    <Button Text="Ver Receta"
                            BackgroundColor="#007ACC"
                            TextColor="White"
                            CornerRadius="8"
                            Clicked="OnVerRecetaClicked"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
